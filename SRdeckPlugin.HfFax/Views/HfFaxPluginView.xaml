<UserControl x:Class="SRdeckPlugin.HfFax.Views.HfFaxPluginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SRdeckPlugin.HfFax.Views"
             xmlns:controls="clr-namespace:SRdeckPlugin.Wpf.Controls;assembly=SRdeckPlugin.Wpf"
             MinWidth="540" MinHeight="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <views:HfFaxSettingsView />

        <Border Grid.Row="1" Style="{DynamicResource PluginFlatOuterPanelStyle}" Margin="6,0,6,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{DynamicResource PluginStatusHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Style="{DynamicResource PluginStatusIndicatorStyle}" Tag="{Binding OverallStatusKind}" />
                            <TextBlock Text="HF-FAX受信" Style="{DynamicResource PluginStatusHeaderTitleStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding ReceiverStateText}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Status}" />
                        <Button Grid.Column="2" Content="手動開始" Command="{Binding ManualStartCommand}"
                                Style="{DynamicResource PluginButtonStyle}" Margin="3,0" />
                        <Button Grid.Column="3" Content="画像停止" Command="{Binding ManualStopCommand}"
                                Style="{DynamicResource PluginButtonStyle}" Margin="3,0" />
                        <Button Grid.Column="4" Content="クリア" Command="{Binding ClearCommand}"
                                Style="{DynamicResource PluginButtonStyle}" Margin="3,0" />
                    </Grid>
                </Border>

                <UniformGrid Grid.Row="1" Columns="4" Margin="10,4,10,14">
                    <Border Style="{DynamicResource PluginMetricCardStyle}"><StackPanel><TextBlock Text="受信ライン" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Text="{Binding CurrentLines, StringFormat=N0}" Foreground="{DynamicResource PluginDisplayAccentPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                    <Border Style="{DynamicResource PluginMetricCardStyle}"><StackPanel><TextBlock Text="画像サイズ" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Text="{Binding CurrentImageDimensions}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border>
                    <Border Style="{DynamicResource PluginMetricCardStyle}"><StackPanel><TextBlock Text="復調トーン" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Text="{Binding ToneFrequencyText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border>
                    <Border Style="{DynamicResource PluginMetricCardStyle}"><StackPanel><TextBlock Text="有効偏移率" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Text="{Binding SignalQualityText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border>
                </UniformGrid>

                <TabControl Grid.Row="2" Style="{DynamicResource PluginTabControlStyle}">
                    <TabItem Header="概要" IsSelected="True">
                        <Grid Margin="10,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="1500 Hz=黒 / 2300 Hz=白"
                                           Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="横位置 (px)"
                                           Foreground="{DynamicResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="8,0,4,0" />
                                <TextBox Grid.Column="2" Width="72" Margin="0,0,8,0"
                                         Text="{Binding HorizontalShiftPixels, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                         Style="{DynamicResource PluginTextBoxStyle}"
                                         ToolTip="正数で右、負数で左へ移動。受信済みラインにも反映します。" />
                                <Button Grid.Column="3" Content="現在画像をPNG保存"
                                        Command="{Binding SaveImageCommand}"
                                        Style="{DynamicResource PluginButtonStyle}" Width="145" />
                            </Grid>
                            <Border Grid.Row="1" Margin="0,6" Padding="4"
                                    Background="{DynamicResource PanelRaisedBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto"
                                              CanContentScroll="False">
                                    <Image Source="{Binding CurrentImage}" Stretch="Uniform"
                                            MaxWidth="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}"
                                            HorizontalAlignment="Center" VerticalAlignment="Top"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                            SnapsToDevicePixels="True"
                                            Cursor="Hand" ToolTip="クリックで受信画像を等倍表示"
                                            MouseLeftButtonUp="CurrentImage_MouseLeftButtonUp" />
                                </ScrollViewer>
                            </Border>
                            <TextBlock Grid.Row="2" Text="{Binding SaveStatus}"
                                       Foreground="{DynamicResource TextDimBrush}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SaveStatus}" />
                        </Grid>
                    </TabItem>

                    <TabItem Header="時系列">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="5" />
                                <RowDefinition Height="190" MinHeight="110" MaxHeight="300" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="8,6,8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="HF-FAX受信時系列"
                                           Foreground="{DynamicResource PluginDisplayAccentPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Foreground="{DynamicResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Run Text="{Binding History.Count, Mode=OneWay, StringFormat={}{0:N0}}" />
                                    <Run Text=" 件" />
                                </TextBlock>
                            </Grid>
                            <Border Grid.Row="1" Style="{DynamicResource PluginTimelineBorderStyle}">
                                <DataGrid ItemsSource="{Binding History}"
                                          SelectedItem="{Binding SelectedHistoryItem, Mode=TwoWay}"
                                          Style="{DynamicResource PluginTimelineDataGridStyle}"
                                          AutoGenerateColumns="False"
                                          RowHeight="68">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="日時" Width="86" SortMemberPath="LocalStartedAt"
                                                                CellStyle="{DynamicResource PluginTimelineTimestampCellStyle}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Style="{DynamicResource PluginTimelineTimestampTextStyle}"
                                                               LineHeight="13" VerticalAlignment="Top" Margin="0">
                                                        <Run Text="{Binding LocalStartedAt, Mode=OneWay, StringFormat={}{0:yyyy/MM/dd}}" />
                                                        <LineBreak />
                                                        <Run Text="{Binding LocalStartedAt, Mode=OneWay, StringFormat={}{0:HH:mm:ss}}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="受信画像" Width="*" MinWidth="240" SortMemberPath="LocalStartedAt">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2,0,2" TextElement.FontFamily="{DynamicResource DisplayFontFamily}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="76" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.RowSpan="3" Background="{DynamicResource PanelRaisedBrush}"
                                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                                BorderThickness="1" Margin="0,0,8,0">
                                                            <Image Source="{Binding Preview, Mode=OneWay}" Stretch="Uniform"
                                                                   Width="68" Height="52"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                                   Cursor="Hand" ToolTip="クリックで受信画像を等倍表示"
                                                                   MouseLeftButtonUp="HistoryImage_MouseLeftButtonUp" />
                                                        </Border>
                                                        <Grid Grid.Column="1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding FormatDisplay}"
                                                                       Style="{DynamicResource PluginTimelineIdentityTextStyle}"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding FrequencyDisplay}"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource TextDimBrush}"
                                                                   Margin="0,3,0,0">
                                                            <Run Text="サイズ " />
                                                            <Run Text="{Binding SizeDisplay, Mode=OneWay}" />
                                                            <Run Text="  /  品質 " />
                                                            <Run Text="{Binding QualityDisplay, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CompletionReason}"
                                                                   Foreground="{DynamicResource TextDimBrush}"
                                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                            <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                                          Background="Transparent" ResizeDirection="Rows" />
                            <controls:SelectionDetailPane Grid.Row="3"
                                DetailContent="{Binding SelectedHistoryItem}"
                                EmptyText="時系列から受信画像を選択すると、詳細を表示します。">
                                <controls:SelectionDetailPane.DetailContentTemplate>
                                    <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="受信画像の詳細" Style="{DynamicResource PluginSecondarySectionHeaderStyle}" />
                                        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextDimBrush}">
                                            <Run Text="周波数: "/><Run Text="{Binding FrequencyDisplay, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Foreground="{DynamicResource TextDimBrush}">
                                            <Run Text="方式: "/><Run Text="{Binding FormatDisplay, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Foreground="{DynamicResource TextDimBrush}">
                                            <Run Text="画像: "/><Run Text="{Binding SizeDisplay, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Foreground="{DynamicResource TextDimBrush}">
                                            <Run Text="完了: "/><Run Text="{Binding CompletionReason, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding AlignmentDisplay, Mode=OneWay}"
                                                   Foreground="{DynamicResource TextDimBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource PanelRaisedBrush}"
                                            BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Padding="2">
                                        <Image Source="{Binding Preview, Mode=OneWay}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Cursor="Hand" ToolTip="クリックで受信画像を等倍表示"
                                               MouseLeftButtonUp="HistoryImage_MouseLeftButtonUp" />
                                    </Border>
                                </Grid>
                                    </DataTemplate>
                                </controls:SelectionDetailPane.DetailContentTemplate>
                            </controls:SelectionDetailPane>
                        </Grid>
                    </TabItem>

                    <TabItem Header="診断">
                        <DockPanel Margin="12,10" LastChildFill="True">
                            <controls:DiagnosticsOverview DockPanel.Dock="Top"
                                StatusKind="{Binding OverallStatusKind}"
                                StatusText="{Binding Status}"
                                PhaseText="段階: チャネル化 → FM偏移 → APT同期・VBW → IOC/LPM画像走査"
                                LastUpdatedText="{Binding LastDiagnosticsUpdated, StringFormat=更新 {0}}"
                                SummaryText="{Binding AptDetectorText}"
                                RecommendationText="確認: 割当周波数、IOC、LPM、信号強度、白黒極性を確認してください"
                                RuntimeDiagnostics="{Binding RuntimeDiagnostics}"
                                ChannelText="{Binding CenterFrequencyDisplay, StringFormat=対象 {0} / 2.8 kHz}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel MaxWidth="760">
                                    <Expander Header="リアルタイム処理" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                        <controls:RuntimeDiagnosticsDetails RuntimeDiagnostics="{Binding RuntimeDiagnostics}" />
                                    </Expander>
                                    <Expander Header="入力・復調" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                        <Border Style="{DynamicResource PluginMetricCardStyle}" Margin="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <TextBlock Text="割当周波数" Foreground="{DynamicResource TextDimBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding CenterFrequencyDisplay}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                <TextBlock Grid.Row="1" Text="信号レベル" Foreground="{DynamicResource TextDimBrush}"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SignalLevelText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                <TextBlock Grid.Row="2" Text="瞬時トーン" Foreground="{DynamicResource TextDimBrush}"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ToneFrequencyText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                <TextBlock Grid.Row="3" Text="APT検出" Foreground="{DynamicResource TextDimBrush}"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AptDetectorText}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                    </Expander>
                                    <Expander Header="画像走査" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                        <Border Style="{DynamicResource PluginMetricCardStyle}" Margin="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                                                <TextBlock Text="方式" Foreground="{DynamicResource TextDimBrush}"/>
                                                <TextBlock Grid.Column="1" Foreground="{DynamicResource TextPrimaryBrush}"><Run Text="IOC "/><Run Text="{Binding IocDisplay, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding LinesPerMinuteDisplay, Mode=OneWay}"/><Run Text=" LPM"/></TextBlock>
                                                <TextBlock Grid.Row="1" Text="受信ライン" Foreground="{DynamicResource TextDimBrush}"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentLines, StringFormat={}{0:N0} lines}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                <TextBlock Grid.Row="2" Text="有効偏移率" Foreground="{DynamicResource TextDimBrush}"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SignalQualityText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                <TextBlock Grid.Row="3" Text="ライン同期" Foreground="{DynamicResource TextDimBrush}"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LineSynchronizationText}" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LineSynchronizationText}"/>
                                                <TextBlock Grid.Row="4" Text="受信周期偏差" Foreground="{DynamicResource TextDimBrush}"/>
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding EstimatedSlantText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                            </Grid>
                                        </Border>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
