<UserControl x:Class="SRdeckPlugin.Vdl.Views.VdlSettingsView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:controls="clr-namespace:SRdeckPlugin.Wpf.Controls;assembly=SRdeckPlugin.Wpf">
    <Border Style="{DynamicResource PluginSettingsPanelStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding Status, StringFormat=状態: {0}}" Tag="VDL Mode 2"
                            ToolTip="{Binding Status}"
                            Style="{DynamicResource PluginSettingsHeaderStyle}" />
            <TabControl Grid.Row="1" Style="{DynamicResource PluginSettingsTabControlStyle}">
                <TabItem Header="受信設定">
                    <ScrollViewer Style="{DynamicResource PluginSettingsBodyStyle}">
                        <Grid Margin="12,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="受信周波数" Style="{DynamicResource PluginSettingsFieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Grid.Column="1" Width="140" Height="26"
                                          ItemsSource="{Binding Channels}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedProfileId, Mode=TwoWay}"
                                          Style="{DynamicResource PluginComboBoxStyle}" />
                                <TextBlock Grid.Column="2" Text="同期記号数" Margin="16,0,8,0"
                                           Style="{DynamicResource PluginSettingsFieldLabelStyle}"/>
                                <ComboBox Grid.Column="3" Width="90" Height="26"
                                          ItemsSource="{Binding AvailablePreambleVerificationSymbols}"
                                          SelectedItem="{Binding PreambleVerificationSymbols, Mode=TwoWay}"
                                          Style="{DynamicResource PluginComboBoxStyle}" />
                            </Grid>

                            <WrapPanel Grid.Row="1" Margin="0,0,0,10" VerticalAlignment="Center">
                                <CheckBox Content="音声モニターを有効化"
                                          IsChecked="{Binding IsAudioMonitorEnabled, Mode=TwoWay}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          VerticalAlignment="Center" Margin="0,0,16,0" />
                                <CheckBox Content="スケルチ"
                                          IsChecked="{Binding IsSquelchEnabled, Mode=TwoWay}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          VerticalAlignment="Center" Margin="0,0,16,0" />
                                <CheckBox Content="適応等化器 (D8PSK)"
                                          IsChecked="{Binding IsAdaptiveEqualizerEnabled, Mode=TwoWay}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          VerticalAlignment="Center" />
                            </WrapPanel>

                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="プラグイン設定">
                    <ScrollViewer Style="{DynamicResource PluginSettingsBodyStyle}">
                        <Grid Margin="12,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="表示と履歴の保持" Style="{DynamicResource PluginSecondarySectionHeaderStyle}" />
                            <TextBlock Grid.Row="1"
                                       Text="履歴保持件数はJSONLと時系列表示に適用され、保存対象を設定できます。"
                                       Style="{DynamicResource PluginSettingsHintStyle}" Margin="0,4,0,10" />

                            <Grid Grid.Row="2" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" /><RowDefinition Height="28" /><RowDefinition Height="28" /><RowDefinition Height="28" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="最大表示機数" Style="{DynamicResource PluginSettingsFieldLabelStyle}" />
                                <TextBox Grid.Column="1" Text="{Binding MaximumAircraft, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left" Style="{DynamicResource PluginTextBoxStyle}" />
                                <TextBlock Grid.Column="2" Text="Callsign一覧に同時に保持する最大機数" Style="{DynamicResource PluginSettingsHintStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="機体非表示時間（分）" Style="{DynamicResource PluginSettingsFieldLabelStyle}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RetentionMinutes, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left" Style="{DynamicResource PluginTextBoxStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="電波途絶から一覧から消去するまでの時間" Style="{DynamicResource PluginSettingsHintStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Text="航跡保持点数" Style="{DynamicResource PluginSettingsFieldLabelStyle}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MaximumTrailPoints, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left" Style="{DynamicResource PluginTextBoxStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="地図上に保持する航跡点数（ディスク履歴とは別）" Style="{DynamicResource PluginSettingsHintStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="3" Text="履歴保持件数" Style="{DynamicResource PluginSettingsFieldLabelStyle}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MaximumHistory, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left" Style="{DynamicResource PluginTextBoxStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="JSONLと時系列表示に保持する最大件数" Style="{DynamicResource PluginSettingsHintStyle}" VerticalAlignment="Center" />
                             </Grid>
                             <controls:PluginResetView Grid.Row="3" />
                             <TextBlock Grid.Row="4" Text="過去録音" Style="{DynamicResource PluginSecondarySectionHeaderStyle}" Margin="0,0,0,7" />
                             <TextBlock Grid.Row="5" Text="受信中に直前3秒のIQデータを保存します。"
                                        Style="{DynamicResource PluginSettingsHintStyle}" Margin="0,4,0,10" />
                             <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="IQ 録音 (直前3秒)" Command="{Binding TriggerCaptureCommand}"
                                        Style="{DynamicResource PluginButtonStyle}" Width="130" Height="22" />
                                <TextBlock Grid.Column="1" Text="{Binding CaptureStatus}" Style="{DynamicResource PluginSettingsActionStatusStyle}" />
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </Grid>
    </Border>
</UserControl>
