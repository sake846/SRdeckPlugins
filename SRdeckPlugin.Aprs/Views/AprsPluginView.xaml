<UserControl x:Class="SRdeckPlugin.Aprs.Views.AprsPluginView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:SRdeckPlugin.Aprs.Views"
 xmlns:wpf="clr-namespace:SRdeckPlugin.Wpf;assembly=SRdeckPlugin.Wpf"
 xmlns:controls="clr-namespace:SRdeckPlugin.Wpf.Controls;assembly=SRdeckPlugin.Wpf"
 Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource MainFontFamily}"
 FontSize="10" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Grid Margin="6">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <views:AprsSettingsView />
  <Border Grid.Row="1" Style="{DynamicResource PluginFlatOuterPanelStyle}" Margin="0,6,0,0">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{DynamicResource PluginStatusHeaderStyle}">
     <DockPanel>
      <Ellipse Style="{DynamicResource PluginStatusIndicatorStyle}" Tag="{Binding OverallStatusKind}"/>
      <TextBlock Text="受信状態" Style="{DynamicResource PluginStatusHeaderTitleStyle}"/>
      <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
     </DockPanel>
    </Border>
    <TabControl Grid.Row="1" Style="{DynamicResource PluginTabControlStyle}">
     <TabItem Header="概要"><StackPanel Margin="10">
      <TextBlock Text="受信で分かったこと" Style="{DynamicResource PluginPrimarySectionHeaderStyle}"/>
      <TextBlock Text="{Binding Overview}" TextWrapping="Wrap" Margin="0,8"/>
      <TextBlock Text="一覧で局・対象を比較し、時系列でパケット本文、数値グラフで気象・テレメトリ、地図で最新位置を確認できます。" TextWrapping="Wrap"/>
     </StackPanel></TabItem>
     <TabItem Header="一覧"><DataGrid ItemsSource="{Binding Stations}" AutoGenerateColumns="False" IsReadOnly="True"
       EnableRowVirtualization="True" EnableColumnVirtualization="True" Style="{DynamicResource PluginDataGridStyle}">
      <DataGrid.Columns>
       <DataGridTextColumn Header="対象" Binding="{Binding Label}" Width="*"/>
       <DataGridTextColumn Header="送信元" Binding="{Binding Source}" Width="100"/>
       <DataGridTextColumn Header="受信数" Binding="{Binding Packets}" Width="60"/>
       <DataGridTextColumn Header="緯度" Binding="{Binding Latitude, StringFormat=F5}" Width="85"/>
       <DataGridTextColumn Header="経度" Binding="{Binding Longitude, StringFormat=F5}" Width="85"/>
       <DataGridTextColumn Header="最終受信" Binding="{Binding LastReceived, StringFormat=HH:mm:ss}" Width="85"/>
      </DataGrid.Columns>
     </DataGrid></TabItem>
     <TabItem Header="時系列"><Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="140"/></Grid.RowDefinitions>
      <Button Content="履歴を保存…" Command="{Binding ExportCommand}" Style="{DynamicResource PluginButtonStyle}" HorizontalAlignment="Right" Margin="6"/>
      <DataGrid Grid.Row="1" ItemsSource="{Binding Packets}" SelectedItem="{Binding SelectedPacket}" AutoGenerateColumns="False"
        IsReadOnly="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" Style="{DynamicResource PluginTimelineDataGridStyle}">
       <DataGrid.Columns>
        <DataGridTextColumn Header="受信時刻" Binding="{Binding ReceivedAt, StringFormat=HH:mm:ss}" Width="85"/>
        <DataGridTextColumn Header="送信元" Binding="{Binding Source}" Width="105"/>
        <DataGridTextColumn Header="種別" Binding="{Binding Kind}" Width="100"/>
        <DataGridTextColumn Header="内容" Binding="{Binding Information}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
      <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch"/>
      <TextBox Grid.Row="3" Text="{Binding SelectedDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
       VerticalScrollBarVisibility="Auto" Style="{DynamicResource PluginTextBoxStyle}" Margin="6"/>
     </Grid></TabItem>
     <TabItem Header="数値グラフ"><Grid Margin="6">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <WrapPanel>
       <TextBlock Text="局・対象" VerticalAlignment="Center" Margin="0,0,6,0"/>
       <ComboBox ItemsSource="{Binding GraphStations}" SelectedItem="{Binding SelectedGraphStation}" MinWidth="130" MaxWidth="220"
        AutomationProperties.Name="グラフの局・対象" Style="{DynamicResource PluginComboBoxStyle}" Margin="0,0,12,4"/>
       <TextBlock Text="項目" VerticalAlignment="Center" Margin="0,0,6,0"/>
       <ComboBox ItemsSource="{Binding GraphMetrics}" SelectedItem="{Binding SelectedGraphMetric}" DisplayMemberPath="Label" MinWidth="180"
        AutomationProperties.Name="グラフの数値項目" Style="{DynamicResource PluginComboBoxStyle}" Margin="0,0,0,4"/>
      </WrapPanel>
      <TextBlock Grid.Row="1" Text="{Binding GraphStatus}" TextWrapping="Wrap" Margin="0,4"/>
      <views:AprsTimeSeriesPlot Grid.Row="2" Points="{Binding GraphPoints}" Metric="{Binding SelectedGraphMetric}"
       Focusable="True" ClipToBounds="True" AutomationProperties.Name="APRS数値の時系列グラフ"
       ToolTip="左右キーで受信値を確認できます。"/>
      <DataGrid Grid.Row="3" ItemsSource="{Binding GraphPoints}" AutoGenerateColumns="False" IsReadOnly="True"
       EnableRowVirtualization="True" Style="{DynamicResource PluginDataGridStyle}" AutomationProperties.Name="グラフの受信値一覧">
       <DataGrid.Columns>
        <DataGridTextColumn Header="受信時刻（UTCオフセット付）" Binding="{Binding ReceivedAt, StringFormat=yyyy/MM/dd HH:mm:ss.fff zzz}" Width="*"/>
        <DataGridTextColumn Header="値（選択項目の単位）" Binding="{Binding Value, StringFormat=G8}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
     </Grid></TabItem>
     <TabItem Header="地図"><Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding MapStatus}" TextWrapping="Wrap" Margin="8"/>
      <wpf:GeoMapView Grid.Row="1" MapId="aprs" ItemsSource="{Binding MapMarkers}" LabelToggleText="局名・対象名" ShowTrailToggle="False"/>
     </Grid></TabItem>
     <TabItem Header="診断"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10">
      <TextBlock Text="{Binding Diagnostics}" TextWrapping="Wrap"/>
      <TextBlock Text="信号があっても結果が出ない場合は、受信方式（AFSK 1200 / GMSK 9600）、周波数、入力帯域、周波数補正、ゲインを確認してください。"
       TextWrapping="Wrap" Margin="0,10"/>
      <controls:RuntimeDiagnosticsDetails RuntimeDiagnostics="{Binding RuntimeDiagnostics}"/>
     </StackPanel></ScrollViewer></TabItem>
    </TabControl>
   </Grid>
  </Border>
 </Grid>
</UserControl>
