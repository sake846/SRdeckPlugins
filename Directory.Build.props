<Project>
  <PropertyGroup>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseLocalSRdeckSources>false</UseLocalSRdeckSources>
    <SRdeckPlatformVersion Condition="'$(SRdeckPlatformVersion)' == ''">1.0.0</SRdeckPlatformVersion>
  </PropertyGroup>
</Project>
