<UserControl x:Class="SRdeckPlugin.Acars.Views.AcarsSettingsView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:controls="clr-namespace:SRdeckPlugin.Wpf.Controls;assembly=SRdeckPlugin.Wpf"
              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10">
    <Border Style="{DynamicResource PluginSettingsPanelStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding SettingStatus}" Tag="ACARS"
                            ToolTip="{Binding SettingStatus}"
                            Style="{DynamicResource PluginSettingsHeaderStyle}" />
            <TabControl Grid.Row="1" Style="{DynamicResource PluginSettingsTabControlStyle}">
                <TabItem Header="受信設定">
                    <ScrollViewer Style="{DynamicResource PluginSettingsBodyStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="Auto" MinHeight="28" />
                                <RowDefinition Height="28" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="地域" Style="{DynamicResource PluginSettingsFieldLabelStyle}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Regions}"
                                      SelectedItem="{Binding SelectedRegion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Height="22" VerticalContentAlignment="Center" Width="130" HorizontalAlignment="Left" />
                            <TextBlock Grid.Row="1" Text="同時受信" Style="{DynamicResource PluginSettingsFieldLabelStyle}"
                                       VerticalAlignment="Top" Margin="0,7,0,0" />
                            <ScrollViewer Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Margin="0,3,0,3">
                                <ItemsControl ItemsSource="{Binding RegionalChannelSelections}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsMonitored, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Content="{Binding DisplayName}" Margin="0,3,14,3"
                                                      Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="MonitorAudioLabelTextBlock" Grid.Row="2"
                                       Text="モニター音声" Style="{DynamicResource PluginSettingsFieldLabelStyle}" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" Orientation="Horizontal" VerticalAlignment="Center">
                                <ToggleButton x:Name="MonitorAudioToggleButton"
                                              Content="音声出力"
                                              IsChecked="{Binding IsAudioMonitorEnabled, Mode=TwoWay}"
                                              Style="{DynamicResource PluginToggleButtonStyle}"
                                              Width="60" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ToggleButton Content="スケルチ"
                                              IsChecked="{Binding IsSquelchEnabled, Mode=TwoWay}"
                                              Style="{DynamicResource PluginToggleButtonStyle}"
                                              Width="60" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ToggleButton x:Name="BuzzerToggleButton"
                                              Content="受信ブザー"
                                              IsChecked="{Binding BuzzerEnabled, Mode=TwoWay}"
                                              Style="{DynamicResource PluginToggleButtonStyle}"
                                              Width="65" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="プラグイン設定">
                    <ScrollViewer Style="{DynamicResource PluginSettingsBodyStyle}">
                        <Grid Margin="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="表示と履歴の保持" Style="{DynamicResource PluginSettingsSectionHeaderStyle}" />
                            <TextBlock Grid.Row="1" Text="時系列に表示する件数と、保存済みデータを保持する量を指定します。"
                                       Style="{DynamicResource PluginSettingsDescriptionStyle}" />
                            <Grid Grid.Row="2" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="300" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="最大表示機数" Style="{DynamicResource PluginSettingsFieldLabelStyle}" />
                                <TextBox Grid.Column="1" Text="{Binding MaximumAircraft, UpdateSourceTrigger=LostFocus}"
                                         Width="100" HorizontalAlignment="Left" Style="{DynamicResource PluginTextBoxStyle}" />
                                <TextBlock Grid.Column="2" Text="機体一覧・地図に同時に保持する最大機数"
                                           Style="{DynamicResource PluginSettingsHintStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="機体非表示時間（分）" Style="{DynamicResource PluginSettingsFieldLabelStyle}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RetentionMinutes, UpdateSourceTrigger=LostFocus}"
                                         Width="100" HorizontalAlignment="Left" Style="{DynamicResource PluginTextBoxStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="電波途絶から一覧・地図から消去するまでの時間"
                                           Style="{DynamicResource PluginSettingsHintStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Text="航跡保持点数" Style="{DynamicResource PluginSettingsFieldLabelStyle}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MaximumTrailPoints, UpdateSourceTrigger=LostFocus}"
                                         Width="100" HorizontalAlignment="Left" Style="{DynamicResource PluginTextBoxStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="地図上に保持する航跡点数（ディスク履歴とは別）"
                                           Style="{DynamicResource PluginSettingsHintStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="3" Text="履歴保持件数" Style="{DynamicResource PluginSettingsFieldLabelStyle}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MaximumHistory, UpdateSourceTrigger=LostFocus}"
                                         Width="100" HorizontalAlignment="Left" Style="{DynamicResource PluginTextBoxStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="時系列タブに表示・保持する最大件数"
                                           Style="{DynamicResource PluginSettingsHintStyle}" VerticalAlignment="Center" />
                                <CheckBox Grid.Row="4" Grid.ColumnSpan="3" Content="未解読・要確認メッセージを別ログへ保存"
                                          IsChecked="{Binding SaveUninterpretedMessages, Mode=TwoWay}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                             </Grid>
                             <controls:PluginResetView Grid.Row="3" />
                             <TextBlock Grid.Row="4" Text="過去録音" Style="{DynamicResource PluginSettingsSectionHeaderStyle}" />
                             <Grid Grid.Row="5" Style="{DynamicResource PluginSettingsActionRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="受信中に直前3秒のIQデータを保存します。"
                                           Style="{DynamicResource PluginSettingsHintStyle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <Button Grid.Column="1" Content="IQ 録音 (直前3秒)" Command="{Binding StartCaptureCommand}"
                                        Style="{DynamicResource PluginButtonStyle}" Height="22" Width="130" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="2" Text="{Binding CaptureStatus}"
                                           Style="{DynamicResource PluginSettingsActionStatusStyle}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
