<UserControl x:Class="SRdeckPlugin.AdsB.Views.AdsBPluginView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:views="clr-namespace:SRdeckPlugin.AdsB.Views"
              xmlns:adsb="clr-namespace:SRdeckPlugin.AdsB"
              xmlns:wpf="clr-namespace:SRdeckPlugin.Wpf;assembly=SRdeckPlugin.Wpf"
              xmlns:controls="clr-namespace:SRdeckPlugin.Wpf.Controls;assembly=SRdeckPlugin.Wpf">
    <UserControl.Resources>
        <Style x:Key="AdsBDataGridRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource PluginDataGridRowStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasEmergency}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PluginStatusCriticalBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource PluginStatusCriticalForegroundBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <views:AdsBSettingsView Grid.Row="0"/>

        <Border Grid.Row="1" Style="{DynamicResource PluginFlatOuterPanelStyle}" Margin="6,0,6,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{DynamicResource PluginStatusHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Style="{DynamicResource PluginStatusIndicatorStyle}" Tag="{Binding OverallStatusKind}"/>
                            <TextBlock Text="受信状態" Style="{DynamicResource PluginStatusHeaderTitleStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="クリア" Command="{Binding ClearAircraftCommand}" Width="60" Height="26" FontSize="10"/>
                    </Grid>
                </Border>
                <TabControl Grid.Row="1" Style="{DynamicResource PluginTabControlStyle}" Padding="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10">
                    <!-- 1. 概要 -->
                    <TabItem Header="概要">
                        <Grid Margin="10,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="受信の概況" Style="{DynamicResource PluginPrimarySectionHeaderStyle}" Margin="2,0,0,5"/>
                            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,8">
                                <Border Style="{DynamicResource PluginMetricCardStyle}"><StackPanel><TextBlock Text="追跡中の機体" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Text="{Binding Aircraft.Count}" Foreground="{DynamicResource PluginDisplayAccentPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                                <Border Style="{DynamicResource PluginMetricCardStyle}"><StackPanel><TextBlock Text="位置取得機" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Text="{Binding PositionedAircraftCount, StringFormat=N0}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                                <Border Style="{DynamicResource PluginMetricCardStyle}"><StackPanel><TextBlock Text="受信レート" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Text="{Binding ValidFramesPerSecond, StringFormat={}{0:F1} frame/s}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                                <Border Style="{DynamicResource PluginMetricCardStyle}"><StackPanel><TextBlock Text="正常率（累計）" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Text="{Binding AcceptanceRateText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                            </UniformGrid>
                            <Border Grid.Row="2" Style="{DynamicResource PluginMetricCardStyle}" Padding="8,6">
                                <StackPanel>
                                    <TextBlock Text="受信成果" Style="{DynamicResource PluginSecondarySectionHeaderStyle}"/>
                                    <TextBlock Text="{Binding OverallSummary}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding OverallRecommendation}" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Grid.Row="3" Text="最近変化した機体（最大3件）" Style="{DynamicResource PluginPrimarySectionHeaderStyle}" Margin="2,2,0,5"/>
                            <ListBox Grid.Row="4" ItemsSource="{Binding RecentAircraft}" Style="{DynamicResource PluginCompactListStyle}" VerticalAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,0,0,1" Padding="6,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="105"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Icao}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Callsign}" Foreground="{DynamicResource PluginDisplayAccentTertiaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding AltitudeFeet, StringFormat={}{0:N0} ft}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding SpeedKnots, StringFormat={}{0:F0} kt}" Foreground="{DynamicResource TextDimBrush}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                <TextBlock Grid.Column="4" Text="{Binding LastSeen, StringFormat=HH:mm:ss}" Foreground="{DynamicResource TextDimBrush}" FontFamily="{DynamicResource DisplayFontFamily}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <!-- 2. 対象一覧 -->
                    <TabItem Header="一覧">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="210" MinHeight="96" MaxHeight="260"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="8,6,8,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="追跡中の機体の現在状態" Foreground="{DynamicResource PluginDisplayAccentPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="検索" Style="{DynamicResource PluginListSearchLabelStyle}"/>
                                <TextBox Grid.Column="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource PluginListSearchTextBoxStyle}"/>
                                <TextBlock Grid.Column="3" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Run Text="{Binding FilteredAircraft.Count, Mode=OneWay, StringFormat=N0}"/><Run Text=" 機"/>
                                </TextBlock>
                            </Grid>
                            <Border Grid.Row="1" Style="{DynamicResource PluginTimelineBorderStyle}">
                            <Grid>
                                <DataGrid x:Name="AdsbAircraftDataGrid" ItemsSource="{Binding FilteredAircraft}" SelectedItem="{Binding SelectedAircraft}"
                                          Style="{DynamicResource PluginTimelineDataGridStyle}" RowStyle="{StaticResource AdsBDataGridRowStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="最終受信" Width="82" SortMemberPath="LastSeen" SortDirection="Descending"
                                                                CellStyle="{DynamicResource PluginTimelineTimestampCellStyle}">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <TextBlock Style="{DynamicResource PluginTimelineTimestampTextStyle}" LineHeight="13" VerticalAlignment="Top" Margin="0,2,0,0">
                                                    <Run Text="{Binding LastSeen, Mode=OneWay, StringFormat={}{0:yyyy/MM/dd}}"/><LineBreak/>
                                                    <Run Text="{Binding LastSeen, Mode=OneWay, StringFormat={}{0:HH:mm:ss}}"/>
                                                </TextBlock>
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="機体" Width="*" MinWidth="200" SortMemberPath="Callsign">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <Grid Margin="0,2,0,3" TextElement.FontFamily="{DynamicResource DisplayFontFamily}">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Callsign, TargetNullValue=-}" Style="{DynamicResource PluginTimelineIdentityTextStyle}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0">
                                                            <Run Text="ICAO "/><Run Text="{Binding Icao, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </Grid>
                                                    <TextBlock Grid.Row="1" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap">
                                                        <Run Text="高度 "/><Run Text="{Binding AltitudeFeet, Mode=OneWay, StringFormat={}{0:N0} ft, TargetNullValue=-}"/>
                                                        <Run Text="  /  速度 "/><Run Text="{Binding SpeedKnots, Mode=OneWay, StringFormat={}{0:F0} kt, TargetNullValue=-}"/>
                                                        <Run Text="  /  方位 "/><Run Text="{Binding TrackDegrees, Mode=OneWay, StringFormat={}{0:F0}°, TargetNullValue=-}"/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Row="2" Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0">
                                                        <Run Text="緊急状態 "/><Run Text="{Binding EmergencyState, Mode=OneWay}"/>
                                                        <Run Text="  /  Squawk "/><Run Text="{Binding Squawk, Mode=OneWay}"/>
                                                        <Run Text="  /  受信 "/><Run Text="{Binding Messages, Mode=OneWay, StringFormat=N0}"/><Run Text=" 件"/>
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="まだ追跡中の機体はありません">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource PluginEmptyStateTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=AdsbAircraftDataGrid}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            </Border>

                            <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                                          Background="Transparent" ResizeDirection="Rows"/>
                            <controls:SelectionDetailPane Grid.Row="3" DetailContent="{Binding SelectedAircraft}"
                                EmptyText="一覧から機体を選択すると、位置・動静・運航状態が表示されます">
                                <controls:SelectionDetailPane.DetailContentTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="3*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <UniformGrid Columns="2" Margin="0,2">
                                                    <StackPanel Margin="2">
                                                        <TextBlock Text="ICAO" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/>
                                                        <TextBlock Text="{Binding Icao}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="2">
                                                        <TextBlock Text="コールサイン" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/>
                                                        <TextBlock Text="{Binding Callsign}" Style="{DynamicResource PluginIdentityTextStyle}"/>
                                                    </StackPanel>
                                                </UniformGrid>
                                                <UniformGrid Columns="2" Margin="0,2">
                                                    <StackPanel Margin="2">
                                                        <TextBlock Text="最終受信" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/>
                                                        <TextBlock Text="{Binding LastSeen, StringFormat=HH:mm:ss}" Foreground="{DynamicResource TextDimBrush}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="2">
                                                        <TextBlock Text="緯度" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/>
                                                        <TextBlock Text="{Binding Latitude, StringFormat=F5}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                    </StackPanel>
                                                </UniformGrid>
                                                <UniformGrid Columns="2" Margin="0,2">
                                                    <StackPanel Margin="2">
                                                        <TextBlock Text="経度" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/>
                                                        <TextBlock Text="{Binding Longitude, StringFormat=F5}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                    </StackPanel>
                                                    <StackPanel Margin="2">
                                                        <TextBlock Text="高度" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/>
                                                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}">
                                                            <Run Text="{Binding AltitudeFeet, Mode=OneWay, StringFormat=N0}"/><Run Text=" ft"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </UniformGrid>
                                                <UniformGrid Columns="2" Margin="0,2">
                                                    <StackPanel Margin="2">
                                                        <TextBlock Text="速度" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/>
                                                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}">
                                                            <Run Text="{Binding SpeedKnots, Mode=OneWay, StringFormat=F0}"/><Run Text=" kt"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Margin="2">
                                                        <TextBlock Text="方位 / 針路" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/>
                                                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}">
                                                            <Run Text="{Binding TrackDegrees, Mode=OneWay, StringFormat=F0}"/><Run Text="°"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </UniformGrid>
                                                <UniformGrid Columns="2" Margin="0,2">
                                                    <StackPanel Margin="2">
                                                        <TextBlock Text="昇降率 / 高度基準" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/>
                                                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"><Run Text="{Binding VerticalRate, Mode=OneWay, StringFormat={}{0:+#;-#;0} ft/min}"/><Run Text=" / "/><Run Text="{Binding AltitudeSource, Mode=OneWay}"/></TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Margin="2">
                                                        <TextBlock Text="選択高度 / Squawk" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/>
                                                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"><Run Text="{Binding SelectedAltitudeFeet, Mode=OneWay, StringFormat=N0}"/><Run Text=" / "/><Run Text="{Binding Squawk, Mode=OneWay}"/></TextBlock>
                                                    </StackPanel>
                                                </UniformGrid>
                                                <UniformGrid Columns="2" Margin="0,2">
                                                    <StackPanel Margin="2">
                                                        <TextBlock Text="緊急状態 / Ver" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/>
                                                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"><Run Text="{Binding EmergencyState, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding AdsBVersion, Mode=OneWay}"/></TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Margin="2">
                                                        <TextBlock Text="NACp / SIL / メッセージ数" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/>
                                                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"><Run Text="{Binding NacP, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Sil, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Messages, Mode=OneWay, StringFormat=N0}"/></TextBlock>
                                                    </StackPanel>
                                                </UniformGrid>
                                            </StackPanel>
                                            <Border Grid.Column="1" BorderBrush="{DynamicResource ControlBorderBrush}"
                                                    BorderThickness="1,0,0,0" Padding="8,0,0,0" Margin="8,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="受信履歴" Style="{DynamicResource PluginSecondarySectionHeaderStyle}" Margin="0,0,0,4"/>
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                        <ItemsControl ItemsSource="{Binding History}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,1">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="58"/>
                                                                            <ColumnDefinition Width="78"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding ReceivedAt, StringFormat=HH:mm:ss}" Foreground="{DynamicResource TextDimBrush}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                                        <TextBlock Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                                                            <Run Text="{Binding Callsign, Mode=OneWay}" Foreground="{DynamicResource PluginDisplayAccentTertiaryBrush}"/><Run Text="  "/><Run Text="{Binding Icao, Mode=OneWay}"/>
                                                                        </TextBlock>
                                                                        <TextBlock Grid.Column="2" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}">
                                                                            <Run Text="{Binding Kind, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Summary, Mode=OneWay}"/>
                                                                        </TextBlock>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </controls:SelectionDetailPane.DetailContentTemplate>
                            </controls:SelectionDetailPane>
                        </Grid>
                    </TabItem>

                    <TabItem Header="時系列">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition Height="160" MinHeight="96" MaxHeight="260"/></Grid.RowDefinitions>
                            <Grid Margin="8,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="時系列順" Foreground="{DynamicResource PluginDisplayAccentPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="検索" Style="{DynamicResource PluginListSearchLabelStyle}"/>
                                <TextBox Grid.Column="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource PluginListSearchTextBoxStyle}"/>
                                <TextBlock Grid.Column="3" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Run Text="{Binding FilteredMessages.Count, Mode=OneWay, StringFormat=N0}"/><Run Text=" 件"/>
                                </TextBlock>
                            </Grid>
                            <Border Grid.Row="1" Style="{DynamicResource PluginTimelineBorderStyle}">
                            <Grid>
                                <DataGrid x:Name="AdsbTimelineGrid" ItemsSource="{Binding FilteredMessages}"
                                          SelectedItem="{Binding SelectedTimelineMessage, Mode=TwoWay}" Style="{DynamicResource PluginTimelineDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="日時" Width="82" SortMemberPath="ReceivedAt"
                                                                CellStyle="{DynamicResource PluginTimelineTimestampCellStyle}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Style="{DynamicResource PluginTimelineTimestampTextStyle}" LineHeight="13" VerticalAlignment="Top" Margin="0,2,0,0">
                                                        <Run Text="{Binding ReceivedAt, Mode=OneWay, StringFormat={}{0:yyyy/MM/dd}}"/><LineBreak/>
                                                        <Run Text="{Binding ReceivedAt, Mode=OneWay, StringFormat={}{0:HH:mm:ss}}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="受信イベント" Width="*" MinWidth="200" SortMemberPath="Callsign">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2,0,3" TextElement.FontFamily="{DynamicResource DisplayFontFamily}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Callsign, TargetNullValue=-}" Style="{DynamicResource PluginTimelineIdentityTextStyle}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                                                        </Grid>
                                                        <TextBlock Grid.Row="1" Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0">
                                                            <Run Text="ICAO "/><Run Text="{Binding Icao, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock Grid.Row="2" Text="{Binding Summary}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        <TextBlock Grid.Row="3" Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0" TextWrapping="Wrap">
                                                            <Run Text="高度 "/><Run Text="{Binding AltitudeFeet, Mode=OneWay, StringFormat={}{0:N0} ft, TargetNullValue=-}"/>
                                                            <Run Text="  /  速度 "/><Run Text="{Binding SpeedKnots, Mode=OneWay, StringFormat={}{0:F0} kt, TargetNullValue=-}"/>
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="該当する受信イベントはありません">
                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource PluginEmptyStateTextStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=AdsbTimelineGrid}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                             </Grid>
                             </Border>
                            <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"/>
                            <controls:TimelineDetailPane Grid.Row="3" DetailContent="{Binding SelectedTimelineMessage}"
                                EmptyText="時系列の受信イベントを選択すると、ADS-B メッセージの詳細が表示されます">
                                <controls:TimelineDetailPane.DetailContentTemplate><DataTemplate><StackPanel Margin="4,2">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Callsign, TargetNullValue=-}" Style="{DynamicResource PluginIdentityTextStyle}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ReceivedAt, StringFormat={}{0:yyyy/MM/dd HH:mm:ss.fff zzz}}" Style="{DynamicResource PluginTimelineDetailTimestampStyle}"/>
                                    </Grid>
                                    <UniformGrid Columns="4" Margin="0,4,0,2">
                                        <StackPanel><TextBlock Text="ICAO識別子" Style="{DynamicResource PluginTimelineDetailLabelStyle}"/><TextBlock Text="{Binding Icao}" Style="{DynamicResource PluginTimelineDetailValueStyle}"/></StackPanel>
                                        <StackPanel><TextBlock Text="種別" Style="{DynamicResource PluginTimelineDetailLabelStyle}"/><TextBlock Text="{Binding Kind}" Style="{DynamicResource PluginTimelineDetailValueStyle}"/></StackPanel>
                                        <StackPanel><TextBlock Text="高度" Style="{DynamicResource PluginTimelineDetailLabelStyle}"/><TextBlock Text="{Binding AltitudeFeet, StringFormat={}{0:N0} ft, TargetNullValue=—}" Style="{DynamicResource PluginTimelineDetailValueStyle}"/></StackPanel>
                                        <StackPanel><TextBlock Text="速度" Style="{DynamicResource PluginTimelineDetailLabelStyle}"/><TextBlock Text="{Binding SpeedKnots, StringFormat={}{0:F0} kt, TargetNullValue=—}" Style="{DynamicResource PluginTimelineDetailValueStyle}"/></StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="{Binding Summary}" Style="{DynamicResource PluginTimelineDetailValueStyle}" Margin="0,4,0,0"/>
                                </StackPanel></DataTemplate></controls:TimelineDetailPane.DetailContentTemplate>
                            </controls:TimelineDetailPane>
                        </Grid>
                    </TabItem>

                    <!-- 4. 地図 -->
                    <TabItem Header="地図">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Margin="8,6" Padding="4">
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}" FontSize="10">
                                    <Run Text="表示機体数: "/><Run Text="{Binding PositionedAircraftCount, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/><Run Text=" 機　|　針路/航跡: モードS航法ベクトル　|　航跡保持: 直近"/><Run Text="{Binding MaximumTrailPoints, Mode=OneWay, StringFormat={}{0:N0}}"/><Run Text="地点"/>
                                </TextBlock>
                            </Border>
                            <Border Grid.Row="1" Margin="4" Background="{DynamicResource PanelBaseBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="2" ClipToBounds="True">
                                <Grid>
                                    <wpf:GeoMapView MapId="adsb" LegendHtml="{x:Static adsb:AdsBMapPresentation.LegendHtml}" LabelToggleText="機名" ItemsSource="{Binding MapMarkers}"/>
                                    <TextBlock Text="位置情報を取得した追跡機体がまだありません">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PluginEmptyStateTextStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PositionedAircraftCount}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- 5. 診断 -->
                    <TabItem Header="診断">
                        <DockPanel Margin="12,10" LastChildFill="True">
                            <controls:DiagnosticsOverview DockPanel.Dock="Top"
                                StatusKind="{Binding OverallStatusKind}"
                                StatusText="{Binding OverallStatus}"
                                PhaseText="{Binding OverallPhase, StringFormat=段階: {0}}"
                                LastUpdatedText="{Binding OverallLastUpdated, StringFormat=更新 {0}}"
                                SummaryText="{Binding OverallSummary}"
                                RecommendationText="{Binding OverallRecommendation}"
                                RuntimeDiagnostics="{Binding RuntimeDiagnostics}"
                                ChannelText="対象 1090.000 MHz" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel MaxWidth="760" HorizontalAlignment="Stretch">
                                <Expander Header="リアルタイム処理" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                    <controls:RuntimeDiagnosticsDetails RuntimeDiagnostics="{Binding RuntimeDiagnostics}" />
                                </Expander>

                                <!-- 2. 入力・選局 -->
                                <Expander Header="入力・選局" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                <Border Style="{DynamicResource PluginMetricCardStyle}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="入力・選局" Style="{DynamicResource PluginSecondarySectionHeaderStyle}" Margin="0,0,0,9"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                                            <TextBlock Text="中心周波数" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CenterFrequencyText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Text="1090 MHz 偏差" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ChannelOffsetText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Text="対象帯域" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PassbandStatusText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="3" Text="レート変換" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RateConversionSummaryText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="4" Text="IQ入力 → 中間 → 復調レート" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding IntermediateRateText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                </Expander>

                                <!-- 3. 信号・チャネル -->
                                <Expander Header="信号・チャネル" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                <Border Style="{DynamicResource PluginMetricCardStyle}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="信号・チャネル" Style="{DynamicResource PluginSecondarySectionHeaderStyle}" Margin="0,0,0,9"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                                            <TextBlock Text="推定ノイズフロア" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding NoiseFloorText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Text="信号品質 (直近/平均/最大)" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center">
                                                <Run Text="{Binding LastSignalQuality, Mode=OneWay, StringFormat={}{0:F2}}"/><Run Text=" / "/><Run Text="{Binding AverageSignalQuality, Mode=OneWay, StringFormat={}{0:F2}}"/><Run Text=" / "/><Run Text="{Binding MaximumSignalQuality, Mode=OneWay, StringFormat={}{0:F2}}"/>
                                            </TextBlock>
                                            <TextBlock Grid.Row="2" Text="有効フレームレート" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center">
                                                <Run Text="{Binding ValidFramesPerSecond, Mode=OneWay, StringFormat={}{0:F1}}"/><Run Text=" frame/s"/>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                </Expander>

                                <!-- 4. 復調・同期 -->
                                <Expander Header="検出・同期・復調" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                <Border Style="{DynamicResource PluginMetricCardStyle}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="復調・同期" Style="{DynamicResource PluginSecondarySectionHeaderStyle}" Margin="0,0,0,9"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                                            <TextBlock Text="検出到達数" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding RecentDetectionText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Text="timing成立・補正（累積）" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TimingAdjustedFrames, StringFormat=N0}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Text="SIC回収（累積）" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SicRecoveredFrames, StringFormat=N0}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                </Expander>

                                <!-- 5. 検証・復号 -->
                                <Expander Header="検証・復号" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                <Border Style="{DynamicResource PluginMetricCardStyle}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="検証・復号" Style="{DynamicResource PluginSecondarySectionHeaderStyle}" Margin="0,0,0,9"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                                            <TextBlock Text="直近のCRC検証" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding RecentValidationText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="1" Text="CRC検証済み" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ValidFrames, StringFormat=N0}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Text="CRC 1-bit訂正" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CorrectedFrames, StringFormat=N0}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="3" Text="CRC不一致" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RejectedFrames, StringFormat=N0}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="4" Text="検証合格率（累積）" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"><Run Text="{Binding AcceptanceRate, Mode=OneWay, StringFormat=F1}"/><Run Text=" %"/></TextBlock>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                </Expander>

                                <Expander Header="詳細・デバッグ" Style="{DynamicResource PluginDiagnosticsSectionStyle}" IsExpanded="False">
                                    <StackPanel Margin="8,5">
                                        <TextBlock Text="{Binding RateConversionText}" Foreground="{DynamicResource TextDimBrush}" FontFamily="{DynamicResource DisplayFontFamily}" TextWrapping="Wrap"/>
                                        <TextBlock Text="信号品質は信号電力/推定雑音電力の無次元比です。値が大きいほど良好です。" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Expander>

                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
