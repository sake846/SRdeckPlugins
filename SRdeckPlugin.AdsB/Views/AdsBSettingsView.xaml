<UserControl x:Class="SRdeckPlugin.AdsB.Views.AdsBSettingsView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:controls="clr-namespace:SRdeckPlugin.Wpf.Controls;assembly=SRdeckPlugin.Wpf"
              Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10">
    <Border Style="{DynamicResource PluginSettingsPanelStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding SettingStatus}" Tag="ADS-B"
                            ToolTip="{Binding SettingStatus}"
                            Style="{DynamicResource PluginSettingsHeaderStyle}" />
            <TabControl Grid.Row="1" Style="{DynamicResource PluginSettingsTabControlStyle}">
                <TabItem Header="受信設定">
                    <ScrollViewer Style="{DynamicResource PluginSettingsBodyStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" MinHeight="28"/>
                                <RowDefinition Height="Auto" MinHeight="28"/>
                                <RowDefinition Height="Auto" MinHeight="28"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="中心周波数" Style="{DynamicResource PluginSettingsFieldLabelStyle}"/>
                            <TextBlock Grid.Column="1" Text="1,090,000,000 Hz" Style="{DynamicResource PluginSettingsValueStyle}"/>
                            <TextBlock Grid.Column="3" Text="受信方式" Style="{DynamicResource PluginSettingsFieldLabelStyle}"/>
                            <TextBlock Grid.Column="4" Grid.ColumnSpan="2" Text="Mode S / DF17・DF18" Style="{DynamicResource PluginSettingsValueStyle}"/>
                            <TextBlock Grid.Row="1" Text="受信機緯度" Style="{DynamicResource PluginSettingsFieldLabelStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ReceiverLatitude, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Style="{DynamicResource PluginTextBoxStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="受信機経度" Style="{DynamicResource PluginSettingsFieldLabelStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding ReceiverLongitude, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" Style="{DynamicResource PluginTextBoxStyle}"/>
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="6" Text="受信機位置は地上CPRの90°領域決定に使用します。2 MS/s以上のIQサンプルレートが必要です。" Style="{DynamicResource PluginSettingsHintStyle}"/>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="プラグイン設定">
                    <ScrollViewer Style="{DynamicResource PluginSettingsBodyStyle}">
                        <Grid Margin="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="表示と履歴の保持" Style="{DynamicResource PluginSettingsSectionHeaderStyle}" />
                            <TextBlock Grid.Row="1" Text="一覧に表示する機体数と、保存済みデータの件数を指定します。履歴保持期間は無期限です。"
                                       Style="{DynamicResource PluginSettingsDescriptionStyle}" />
                            <Grid Grid.Row="2" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="300" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" /><RowDefinition Height="28" /><RowDefinition Height="28" /><RowDefinition Height="28" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="最大表示機数" Style="{DynamicResource PluginSettingsFieldLabelStyle}" />
                                <TextBox Grid.Column="1" Text="{Binding MaximumAircraft, UpdateSourceTrigger=LostFocus}"
                                         Width="100" HorizontalAlignment="Left" Style="{DynamicResource PluginTextBoxStyle}" />
                                <TextBlock Grid.Column="2" Text="一覧に保持する最大機数"
                                           Style="{DynamicResource PluginSettingsHintStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="機体非表示時間（分）" Style="{DynamicResource PluginSettingsFieldLabelStyle}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RetentionMinutes, UpdateSourceTrigger=LostFocus}"
                                         Width="100" HorizontalAlignment="Left" Style="{DynamicResource PluginTextBoxStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="一覧・地図から機体を除外する時間"
                                           Style="{DynamicResource PluginSettingsHintStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Text="航跡保持点数" Style="{DynamicResource PluginSettingsFieldLabelStyle}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MaximumTrailPoints, UpdateSourceTrigger=LostFocus}"
                                         Width="100" HorizontalAlignment="Left" Style="{DynamicResource PluginTextBoxStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="地図上に保持する航跡点数（ディスク履歴とは別）"
                                           Style="{DynamicResource PluginSettingsHintStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="3" Text="履歴保持件数" Style="{DynamicResource PluginSettingsFieldLabelStyle}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MaximumHistory, UpdateSourceTrigger=LostFocus}"
                                         Width="100" HorizontalAlignment="Left" Style="{DynamicResource PluginTextBoxStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="保存するMode S状態レコードの最大件数"
                                           Style="{DynamicResource PluginSettingsHintStyle}" VerticalAlignment="Center" />
                             </Grid>
                             <controls:PluginResetView Grid.Row="3" />
                             <TextBlock Grid.Row="4" Text="過去録音" Style="{DynamicResource PluginSettingsSectionHeaderStyle}" />
                             <Grid Grid.Row="5" Style="{DynamicResource PluginSettingsActionRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="受信中に直前3秒のIQデータを保存します。"
                                           Style="{DynamicResource PluginSettingsHintStyle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <Button Grid.Column="1" Content="IQ 録音 (直前3秒)" Command="{Binding StartCaptureCommand}"
                                        Style="{DynamicResource PluginButtonStyle}" Height="22" Width="130" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="2" Text="{Binding CaptureStatus}" Style="{DynamicResource PluginSettingsActionStatusStyle}"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
