<UserControl x:Class="SRdeckPlugin.Analog.Views.AnalogPluginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SRdeckPlugin.Analog.Views"
             xmlns:controls="clr-namespace:SRdeckPlugin.Wpf.Controls;assembly=SRdeckPlugin.Wpf"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="AnalogWideFmDisplayBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF061617" Offset="0" />
            <GradientStop Color="#FF010708" Offset="0.5" />
            <GradientStop Color="#FF061112" Offset="1" />
        </LinearGradientBrush>
        <DrawingBrush x:Key="AnalogVfdScanlineBrush" TileMode="Tile" Viewport="0,0,1,4" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#1400F5E9" Geometry="M 0,0 L 1,0 1,1 0,1 Z" />
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <SolidColorBrush x:Key="AnalogWideFmPrimaryBrush" Color="#FF44F6DA" />
        <SolidColorBrush x:Key="AnalogWideFmSecondaryBrush" Color="#FF44F6DA" />
        <SolidColorBrush x:Key="AnalogWideFmBorderBrush" Color="#FF1B7777" />
        <SolidColorBrush x:Key="AnalogWideFmMeterTrackBrush" Color="#FF092324" />
        <SolidColorBrush x:Key="AnalogIndicatorOffBrush" Color="#FF20292A" />
        <SolidColorBrush x:Key="AnalogIndicatorGreenBrush" Color="#FF44F6DA" />
        <SolidColorBrush x:Key="AnalogIndicatorAmberBrush" Color="#FF44F6DA" />
        <SolidColorBrush x:Key="AnalogIndicatorRedBrush" Color="#FF44F6DA" />

        <Style x:Key="AnalogDisplayLegendStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFontFamily}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>
        <Style x:Key="AnalogIndicatorLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF44F6DA" />
            <Setter Property="Opacity" Value="0.68" />
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFontFamily}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="AnalogIndicatorCellStyle" TargetType="Border">
            <Setter Property="Background" Value="#1600FFE5" />
            <Setter Property="BorderBrush" Value="#6644F6DA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="1" />
            <Setter Property="Padding" Value="8,7" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 上段: 受信設定パネル -->
        <views:AnalogSettingsView x:Name="SettingsView" Grid.Row="0" />

        <!-- 下段: 受信状態パネル -->
        <Border Grid.Row="1"
                Style="{DynamicResource PluginFlatOuterPanelStyle}"
                Margin="6,0,6,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 運転状態ヘッダー -->
                <Border Grid.Row="0" Style="{DynamicResource PluginStatusHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusIndicator"
                                     Style="{DynamicResource PluginStatusIndicatorStyle}" />
                            <TextBlock Text="受信状態"
                                       Style="{DynamicResource PluginStatusHeaderTitleStyle}" />
                        </StackPanel>

                        <TextBlock x:Name="StatusTextBlock"
                                   Grid.Column="1"
                                   Foreground="{DynamicResource TextDimBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="12,0,8,0"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <TabControl Grid.Row="1">
                    <TabItem Header="概要">
                        <ScrollViewer
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            Style="{DynamicResource PluginScrollViewerStyle}">
                            <StackPanel Margin="10,8">

                                <!-- 1990年代の2DINカーステレオを思わせる、独自のサイバーVFDフェイス。 -->
                                <Border x:Name="ReceiverFacePanel"
                                        Background="{StaticResource AnalogWideFmDisplayBrush}"
                                        BorderBrush="{StaticResource AnalogWideFmBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Padding="18,14"
                                        Margin="0,0,0,8">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#FF44F6DA" BlurRadius="10" ShadowDepth="0" Opacity="0.13" />
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <DockPanel Margin="2,0,2,7">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                <TextBlock x:Name="ReceiverTitleTextBlock"
                                                           Text="ANALOG DIGITAL TUNER"
                                                           Foreground="{StaticResource AnalogWideFmSecondaryBrush}"
                                                           FontFamily="Arial Narrow"
                                                           FontSize="12"
                                                           FontWeight="Bold" />
                                                <Border x:Name="ReceiverModeBadge"
                                                        Background="#2600FFF0"
                                                        BorderBrush="#9942F7E8"
                                                        BorderThickness="1"
                                                        CornerRadius="1"
                                                        Padding="6,1"
                                                        Margin="9,0,0,0">
                                                    <TextBlock x:Name="ReceiverModeBadgeTextBlock"
                                                               Text="AM"
                                                               Foreground="#FF62FFF2"
                                                               FontFamily="Consolas"
                                                               FontSize="9"
                                                               FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="DSP  •  1/3 OCTAVE REALTIME ANALYZER"
                                                           Foreground="#FF44F6DA" Opacity="0.72" FontFamily="Arial Narrow" FontSize="8" FontWeight="Bold" Margin="0,0,12,0" />
                                                <TextBlock x:Name="ReceiverSeriesTextBlock"
                                                           Text="90s HI-FI SERIES"
                                                           Foreground="{StaticResource AnalogWideFmPrimaryBrush}"
                                                           FontFamily="Arial Narrow"
                                                           FontSize="8"
                                                           FontWeight="Bold" />
                                            </StackPanel>
                                        </DockPanel>

                                        <Grid Grid.Row="1">
                                            <Border Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0">
                                                <Border x:Name="ReceiverDisplayPanel"
                                                        Background="{StaticResource AnalogWideFmDisplayBrush}"
                                                        BorderBrush="{StaticResource AnalogWideFmBorderBrush}"
                                                        BorderThickness="0"
                                                        CornerRadius="0"
                                                        Padding="0,8,0,0">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#FF44F6DA" BlurRadius="8" ShadowDepth="0" Opacity="0.10" />
                                                    </Border.Effect>
                                                    <Grid ClipToBounds="True">
                                                        <Rectangle Fill="{StaticResource AnalogVfdScanlineBrush}" IsHitTestVisible="False" Opacity="0.7" />
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <DockPanel>
                                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                                    <TextBlock Text="◀ DSP" Style="{StaticResource AnalogDisplayLegendStyle}" Foreground="{StaticResource AnalogWideFmSecondaryBrush}" Margin="0,0,10,0" />
                                                                    <TextBlock x:Name="DisplayStatusTextBlock" Text="受信待機" Style="{StaticResource AnalogDisplayLegendStyle}" Foreground="{StaticResource AnalogWideFmSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <TextBlock x:Name="DisplayBandTextBlock" Text="AM / FM / SSB" Style="{StaticResource AnalogDisplayLegendStyle}" Foreground="{StaticResource AnalogWideFmSecondaryBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                                            </DockPanel>

                                                            <Grid Grid.Row="1" Margin="0,1,0,1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock x:Name="MainFrequencyTextBlock"
                                                                           Text="----.---"
                                                                           Foreground="{StaticResource AnalogWideFmPrimaryBrush}"
                                                                           FontFamily="Consolas"
                                                                           FontSize="52"
                                                                           FontWeight="Bold"
                                                                           VerticalAlignment="Center"
                                                                           TextAlignment="Center"
                                                                           TextOptions.TextFormattingMode="Display"
                                                                           AutomationProperties.Name="受信周波数表示">
                                                                    <TextBlock.RenderTransform>
                                                                        <TranslateTransform X="62" />
                                                                    </TextBlock.RenderTransform>
                                                                    <TextBlock.Effect>
                                                                        <DropShadowEffect Color="#FF44F6DA" BlurRadius="7" ShadowDepth="0" Opacity="0.38" />
                                                                    </TextBlock.Effect>
                                                                </TextBlock>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                    <TextBlock Text="MHz" Foreground="{StaticResource AnalogWideFmSecondaryBrush}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" />
                                                                    <TextBlock x:Name="DemodStateTextBlock" Text="—" Foreground="{StaticResource AnalogWideFmPrimaryBrush}" FontFamily="Consolas" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Grid>

                                                            <Grid Grid.Row="2" Margin="0,2,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="S·METER" Style="{StaticResource AnalogDisplayLegendStyle}" Foreground="{StaticResource AnalogWideFmSecondaryBrush}" Margin="0,0,8,0" />
                                                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                                                    <ProgressBar x:Name="SignalLevelProgressBar" Minimum="0" Maximum="150" Height="10" Value="0" Foreground="{StaticResource AnalogWideFmPrimaryBrush}" Background="{StaticResource AnalogWideFmMeterTrackBrush}" BorderThickness="0" />
                                                                    <UniformGrid Columns="15" IsHitTestVisible="False">
                                                                        <Border BorderBrush="#CC031112" BorderThickness="0,0,2,0" /><Border BorderBrush="#CC031112" BorderThickness="0,0,2,0" />
                                                                        <Border BorderBrush="#CC031112" BorderThickness="0,0,2,0" /><Border BorderBrush="#CC031112" BorderThickness="0,0,2,0" />
                                                                        <Border BorderBrush="#CC031112" BorderThickness="0,0,2,0" /><Border BorderBrush="#CC031112" BorderThickness="0,0,2,0" />
                                                                        <Border BorderBrush="#CC031112" BorderThickness="0,0,2,0" /><Border BorderBrush="#CC031112" BorderThickness="0,0,2,0" />
                                                                        <Border BorderBrush="#CC031112" BorderThickness="0,0,2,0" /><Border BorderBrush="#CC031112" BorderThickness="0,0,2,0" />
                                                                        <Border BorderBrush="#CC031112" BorderThickness="0,0,2,0" /><Border BorderBrush="#CC031112" BorderThickness="0,0,2,0" />
                                                                        <Border BorderBrush="#CC031112" BorderThickness="0,0,2,0" /><Border BorderBrush="#CC031112" BorderThickness="0,0,2,0" /><Border />
                                                                    </UniformGrid>
                                                                </Grid>
                                                                <TextBlock x:Name="SignalLevelTextBlock" Grid.Column="2" Text="—" Foreground="{StaticResource AnalogWideFmPrimaryBrush}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Margin="9,0,0,0" />
                                                            </Grid>

                                                            <Grid Grid.Row="3" Margin="0,6,0,0">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="AUDIO LEVEL" Style="{StaticResource AnalogDisplayLegendStyle}" Foreground="{StaticResource AnalogWideFmSecondaryBrush}" />
                                                                    <TextBlock x:Name="AudioLevelTextBlock" Grid.Column="1" Text="—" Foreground="{StaticResource AnalogWideFmPrimaryBrush}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" HorizontalAlignment="Stretch" TextAlignment="Left" Margin="8,0,0,0" />
                                                                </Grid>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                    <TextBlock Text="SQ" Style="{StaticResource AnalogDisplayLegendStyle}" Foreground="{StaticResource AnalogWideFmSecondaryBrush}" />
                                                                    <TextBlock x:Name="SquelchStatusTextBlock" Text="—" Foreground="{StaticResource AnalogWideFmPrimaryBrush}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Margin="8,0,0,0" />
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- 実際の受信・音声レベルに連動するVFDスペクトラム演出。 -->
                                                            <Grid Grid.Row="4" Margin="0,9,0,0" Height="126">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <views:ThirdOctaveVfdSpectrum x:Name="ThirdOctaveSpectrum" />
                                                                <StackPanel Grid.Column="1" Margin="8,2,0,13" VerticalAlignment="Stretch">
                                                                    <TextBlock Text="0" Foreground="#FF44F6DA" Opacity="0.72" FontFamily="Consolas" FontSize="7" />
                                                                    <TextBlock Text="-20" Foreground="#FF44F6DA" Opacity="0.72" FontFamily="Consolas" FontSize="7" VerticalAlignment="Center" Margin="0,30,0,0" />
                                                                    <TextBlock Text="-40" Foreground="#FF44F6DA" Opacity="0.72" FontFamily="Consolas" FontSize="7" Margin="0,29,0,0" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </Border>

                                        </Grid>

                                        <UniformGrid Grid.Row="2" Columns="4" Margin="0,9,0,0">
                                            <Border Style="{StaticResource AnalogIndicatorCellStyle}" Margin="0,0,4,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border x:Name="PowerLamp" Width="9" Height="9" CornerRadius="5" Background="{StaticResource AnalogIndicatorOffBrush}" Margin="0,0,7,0" />
                                                    <TextBlock Text="RECEIVER" Style="{StaticResource AnalogIndicatorLabelStyle}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource AnalogIndicatorCellStyle}" Margin="2,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border x:Name="AfcLamp" Width="9" Height="9" CornerRadius="5" Background="{StaticResource AnalogIndicatorOffBrush}" Margin="0,0,7,0" />
                                                    <TextBlock Text="AFC" Style="{StaticResource AnalogIndicatorLabelStyle}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource AnalogIndicatorCellStyle}" Margin="2,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border x:Name="SquelchLamp" Width="9" Height="9" CornerRadius="5" Background="{StaticResource AnalogIndicatorOffBrush}" Margin="0,0,7,0" ToolTip="スケルチ状態" />
                                                    <TextBlock Text="SQUELCH" Style="{StaticResource AnalogIndicatorLabelStyle}" />
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="StereoIndicatorPanel" Style="{StaticResource AnalogIndicatorCellStyle}" Margin="4,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border x:Name="StereoLamp" Width="9" Height="9" CornerRadius="5" Background="{StaticResource AnalogIndicatorOffBrush}" Margin="0,0,7,0" ToolTip="FMステレオパイロット検出状態" />
                                                    <TextBlock Text="STEREO" Style="{StaticResource AnalogIndicatorLabelStyle}" />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="診断">
                        <DockPanel Margin="10,8" LastChildFill="True">
                            <controls:DiagnosticsOverview x:Name="DiagnosticsOverview"
                                                          DockPanel.Dock="Top" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Expander Header="リアルタイム処理"
                                              Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                        <controls:RuntimeDiagnosticsDetails x:Name="RuntimeDiagnosticsDetails" />
                                    </Expander>
                                    <Expander Header="入力・選局"
                                              Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                        <Border Style="{DynamicResource PluginMetricCardStyle}" Margin="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="22" /><RowDefinition Height="22" /><RowDefinition Height="22" />
                                                    <RowDefinition Height="22" /><RowDefinition Height="22" /><RowDefinition Height="22" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="対象周波数" Foreground="{DynamicResource TextDimBrush}" />
                                                <TextBlock x:Name="DiagnosticFrequencyTextBlock" Grid.Column="1"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontFamily="{DynamicResource DisplayFontFamily}" />
                                                <TextBlock Grid.Row="1" Text="入力サンプルレート" Foreground="{DynamicResource TextDimBrush}" />
                                                <TextBlock x:Name="DiagnosticInputRateTextBlock" Grid.Row="1" Grid.Column="1"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontFamily="{DynamicResource DisplayFontFamily}" />
                                                <TextBlock Grid.Row="2" Text="復調プロファイル" Foreground="{DynamicResource TextDimBrush}" />
                                                <TextBlock x:Name="DiagnosticProfileTextBlock" Grid.Row="2" Grid.Column="1"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Grid.Row="3" Text="受信帯域幅" Foreground="{DynamicResource TextDimBrush}" />
                                                <TextBlock x:Name="DiagnosticBandwidthTextBlock" Grid.Row="3" Grid.Column="1"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontFamily="{DynamicResource DisplayFontFamily}" />
                                                <TextBlock Grid.Row="4" Text="対象帯域" Foreground="{DynamicResource TextDimBrush}" />
                                                <TextBlock x:Name="DiagnosticTuningTextBlock" Grid.Row="4" Grid.Column="1"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                <TextBlock Grid.Row="5" Text="レート変換" Foreground="{DynamicResource TextDimBrush}" />
                                                <TextBlock x:Name="DiagnosticRateConversionTextBlock" Grid.Row="5" Grid.Column="1"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" />
                                                <TextBlock Grid.Row="6" Text="IQ入力 → 中間 → 復調レート" Foreground="{DynamicResource TextDimBrush}" />
                                                <TextBlock x:Name="DiagnosticRatePathTextBlock" Grid.Row="6" Grid.Column="1"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </Expander>
                                    <Expander Header="信号・チャネル"
                                              Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                        <Border Style="{DynamicResource PluginMetricCardStyle}" Margin="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="22" /><RowDefinition Height="22" /><RowDefinition Height="22" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="IQ入力レベル" Foreground="{DynamicResource TextDimBrush}" />
                                                <TextBlock x:Name="DiagnosticSignalTextBlock" Grid.Column="1"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontFamily="{DynamicResource DisplayFontFamily}" />
                                                <TextBlock Grid.Row="1" Text="校正済みIQ入力レベル" Foreground="{DynamicResource TextDimBrush}" />
                                                <TextBlock x:Name="DiagnosticCalibratedSignalTextBlock" Grid.Row="1" Grid.Column="1"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" />
                                                <TextBlock Grid.Row="2" Text="スケルチ状態 / しきい値" Foreground="{DynamicResource TextDimBrush}" />
                                                <TextBlock x:Name="DiagnosticSquelchTextBlock" Grid.Row="2" Grid.Column="1"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </Grid>
                                        </Border>
                                    </Expander>
                                    <Expander Header="復調・音声" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                        <Border Style="{DynamicResource PluginMetricCardStyle}" Margin="0">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="Auto"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                                                <TextBlock Text="音声出力" Foreground="{DynamicResource TextDimBrush}"/>
                                                <TextBlock x:Name="DiagnosticAudioTextBlock" Grid.Column="1" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Grid.Row="1" Text="復調音 RMS / ピーク" Foreground="{DynamicResource TextDimBrush}"/>
                                                <TextBlock x:Name="DiagnosticAudioLevelTextBlock" Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                <TextBlock Grid.Row="2" Text="プロファイル固有状態" Foreground="{DynamicResource TextDimBrush}"/>
                                                <TextBlock x:Name="DiagnosticProfileStateTextBlock" Grid.Row="2" Grid.Column="1" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Row="3" Text="PCM出力レート" Foreground="{DynamicResource TextDimBrush}"/>
                                                <TextBlock x:Name="DiagnosticPcmRateTextBlock" Grid.Row="3" Grid.Column="1" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                            </Grid>
                                        </Border>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
