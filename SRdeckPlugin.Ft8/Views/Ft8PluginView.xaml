<UserControl x:Class="SRdeckPlugin.Ft8.Views.Ft8PluginView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:views="clr-namespace:SRdeckPlugin.Ft8.Views"
              xmlns:ft8="clr-namespace:SRdeckPlugin.Ft8"
              xmlns:wpf="clr-namespace:SRdeckPlugin.Wpf;assembly=SRdeckPlugin.Wpf"
              xmlns:controls="clr-namespace:SRdeckPlugin.Wpf.Controls;assembly=SRdeckPlugin.Wpf">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <views:Ft8SettingsView Grid.Row="0"/>

        <Border Grid.Row="1" Style="{DynamicResource PluginFlatOuterPanelStyle}" Margin="6,0,6,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{DynamicResource PluginStatusHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Style="{DynamicResource PluginStatusIndicatorStyle}" Tag="{Binding OverallStatusKind}"/>
                            <TextBlock Text="受信状態" Style="{DynamicResource PluginStatusHeaderTitleStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="クリア" Command="{Binding ClearCommand}"
                                Style="{DynamicResource PluginButtonStyle}"/>
                    </Grid>
                </Border>

                <UniformGrid Grid.Row="1" Columns="4" Margin="10,4,10,14">
                    <Border Style="{DynamicResource PluginMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="直前区間の復号" Foreground="{DynamicResource TextDimBrush}"/>
                            <TextBlock Foreground="{DynamicResource PluginDisplayAccentPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" FontSize="20" FontWeight="SemiBold"><Run Text="{Binding LastSlotMessages, Mode=OneWay}"/><Run Text=" 件"/></TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource PluginMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="送信局" Foreground="{DynamicResource TextDimBrush}"/>
                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" FontSize="20" FontWeight="SemiBold"><Run Text="{Binding StationsThisSlot, Mode=OneWay}"/><Run Text=" 局"/></TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource PluginMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="SNR中央値" Foreground="{DynamicResource TextDimBrush}"/>
                            <TextBlock Text="{Binding LastSlotSnrText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" FontSize="20" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{DynamicResource PluginMetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="最大時刻ずれ" Foreground="{DynamicResource TextDimBrush}"/>
                            <TextBlock Text="{Binding LastSlotTimeOffsetText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" FontSize="20" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <TabControl Grid.Row="2" Style="{DynamicResource PluginTabControlStyle}">
            <TabItem Header="概要">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10,8">
                        <TextBlock Text="監視範囲" Style="{DynamicResource PluginPrimarySectionHeaderStyle}"
                                   Margin="2,12,0,5"/>
                        <Border Style="{DynamicResource PluginDetailPanelStyle}">
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run Text="{Binding DialFrequencyText, Mode=OneWay}"/>
                                    <Run Text=" + 200～3000 Hz"/>
                                </TextBlock>
                                <TextBlock Text="{Binding ModeDescription}"
                                           Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="一覧">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="170" MinHeight="96" MaxHeight="260"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="8,6,8,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="送信局別" VerticalAlignment="Center"
                                   Foreground="{DynamicResource PluginDisplayAccentPrimaryBrush}" FontSize="10"/>
                        <TextBlock Grid.Column="1" Text="検索" Style="{DynamicResource PluginListSearchLabelStyle}"/>
                        <TextBox Grid.Column="2" Text="{Binding StationSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource PluginListSearchTextBoxStyle}"/>
                        <TextBlock Grid.Column="3" Foreground="{DynamicResource TextDimBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0">
                            <Run Text="{Binding FilteredStationCount, Mode=OneWay, StringFormat=N0}"/><Run Text=" 局"/>
                        </TextBlock>
                    </Grid>

                    <Border Grid.Row="1" Style="{DynamicResource PluginTimelineBorderStyle}">
                        <Grid>
                            <DataGrid x:Name="Ft8StationGrid" ItemsSource="{Binding FilteredStations}"
                                      SelectedItem="{Binding SelectedStation, Mode=TwoWay}"
                                      Style="{DynamicResource PluginTimelineDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="最終受信" Width="82"
                                                            SortMemberPath="LastReceivedAt" SortDirection="Descending"
                                                            CellStyle="{DynamicResource PluginTimelineTimestampCellStyle}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{DynamicResource PluginTimelineTimestampTextStyle}"
                                                           LineHeight="13" VerticalAlignment="Top" Margin="0,2,0,0">
                                                    <Run Text="{Binding LastReceivedAt, Mode=OneWay, StringFormat={}{0:yyyy/MM/dd}}"/><LineBreak/>
                                                    <Run Text="{Binding LastReceivedAt, Mode=OneWay, StringFormat={}{0:HH:mm:ss}}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="送信局" Width="*" MinWidth="200" SortMemberPath="Callsign">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2,0,3" TextElement.FontFamily="{DynamicResource DisplayFontFamily}">
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Callsign}" Style="{DynamicResource PluginTimelineIdentityTextStyle}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0">
                                                            <Run Text="{Binding LatestReception.Mode, Mode=OneWay}"/><Run Text=" / "/>
                                                            <Run Text="{Binding Locator, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </Grid>
                                                    <TextBlock Grid.Row="1" Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis">
                                                        <Run Text="受信 "/><Run Text="{Binding Count, Mode=OneWay, StringFormat=N0}"/><Run Text=" 件  /  SNR "/>
                                                        <Run Text="{Binding LatestReception.SnrDb, Mode=OneWay, StringFormat={}{0:+0;-0;0} dB}"/><Run Text="  /  "/>
                                                        <Run Text="{Binding LatestReception.Message, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="送信局別の受信履歴はありません">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PluginEmptyStateTextStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasItems, ElementName=Ft8StationGrid}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                                  Background="Transparent" ResizeDirection="Rows"/>
                    <controls:SelectionDetailPane Grid.Row="3" DetailContent="{Binding SelectedStation}"
                        EmptyText="一覧から送信局を選択すると、最新メッセージと受信品質が表示されます">
                        <controls:SelectionDetailPane.DetailContentTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="3*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.ColumnSpan="2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Callsign}" Style="{DynamicResource PluginIdentityTextStyle}"/>
                                        <TextBlock Grid.Column="1" Foreground="{DynamicResource TextDimBrush}">
                                            <Run Text="{Binding Count, Mode=OneWay, StringFormat={}{0:N0} 件}"/><Run Text="  最終受信 "/>
                                            <Run Text="{Binding LastReceivedAt, Mode=OneWay, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}"/>
                                        </TextBlock>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,4,8,0">
                                        <UniformGrid Columns="2" Margin="0,0,0,5">
                                            <StackPanel><TextBlock Text="宛先 / 種別" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/><TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}"><Run Text="{Binding LatestReception.ToCall, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding LatestReception.MessageType, Mode=OneWay}"/></TextBlock></StackPanel>
                                            <StackPanel><TextBlock Text="Mode / SNR" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/><TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}"><Run Text="{Binding LatestReception.Mode, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding LatestReception.SnrDb, Mode=OneWay, StringFormat={}{0:+0;-0;0} dB}"/></TextBlock></StackPanel>
                                        </UniformGrid>
                                        <UniformGrid Columns="2">
                                            <StackPanel><TextBlock Text="DT / Sync" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/><TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}"><Run Text="{Binding LatestReception.TimeOffsetSeconds, Mode=OneWay, StringFormat={}{0:F2} s}"/><Run Text=" / "/><Run Text="{Binding LatestReception.SyncScore, Mode=OneWay}"/></TextBlock></StackPanel>
                                            <StackPanel><TextBlock Text="Grid / RF" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/><TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}"><Run Text="{Binding Locator, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding LatestReception.BandFrequencyText, Mode=OneWay}"/></TextBlock></StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource ControlBorderBrush}"
                                            BorderThickness="1,0,0,0" Padding="8,0,0,0" Margin="8,4,0,0">
                                        <StackPanel>
                                            <TextBlock Text="受信履歴" Style="{DynamicResource PluginSecondarySectionHeaderStyle}" Margin="0,0,0,4"/>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding History}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="58"/>
                                                                    <ColumnDefinition Width="78"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding LocalReceivedAt, StringFormat=HH:mm:ss}" Foreground="{DynamicResource TextDimBrush}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                                <TextBlock Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                                                    <Run Text="{Binding ToCall, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding MessageType, Mode=OneWay}"/>
                                                                </TextBlock>
                                                                <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </controls:SelectionDetailPane.DetailContentTemplate>
                    </controls:SelectionDetailPane>
                </Grid>
            </TabItem>

            <TabItem Header="時系列">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition Height="160" MinHeight="96" MaxHeight="260"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="8,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="時系列順" Foreground="{DynamicResource PluginDisplayAccentPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="検索" Style="{DynamicResource PluginListSearchLabelStyle}"/>
                    <TextBox Grid.Column="2" Text="{Binding HistorySearchText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource PluginListSearchTextBoxStyle}"/>
                    <TextBlock Grid.Column="3" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="8,0,0,0"><Run Text="{Binding FilteredHistory.Count, Mode=OneWay, StringFormat=N0}"/><Run Text=" 件"/></TextBlock>
                </Grid>
                <Border Grid.Row="1" Style="{DynamicResource PluginTimelineBorderStyle}">
                <Grid>
                    <DataGrid x:Name="Ft8HistoryGrid" ItemsSource="{Binding FilteredHistory}" SelectedItem="{Binding SelectedTimelineReception, Mode=TwoWay}"
                              Style="{DynamicResource PluginTimelineDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="日時" Width="82" SortMemberPath="LocalReceivedAt"
                                                    CellStyle="{DynamicResource PluginTimelineTimestampCellStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{DynamicResource PluginTimelineTimestampTextStyle}" LineHeight="13" VerticalAlignment="Top" Margin="0,2,0,0">
                                            <Run Text="{Binding LocalReceivedAt, Mode=OneWay, StringFormat={}{0:yyyy/MM/dd}}"/><LineBreak/>
                                            <Run Text="{Binding LocalReceivedAt, Mode=OneWay, StringFormat={}{0:HH:mm:ss}}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="受信イベント" Width="*" MinWidth="200" SortMemberPath="FromCall">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2,0,3" TextElement.FontFamily="{DynamicResource DisplayFontFamily}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding FromCall}" Style="{DynamicResource PluginTimelineIdentityTextStyle}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"><Run Text="{Binding Mode, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding MessageType, Mode=OneWay}"/></TextBlock>
                                            </Grid>
                                            <TextBlock Grid.Row="1" Text="{Binding Message}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="2" Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0" TextWrapping="Wrap">
                                                <Run Text="SNR "/><Run Text="{Binding SnrDb, Mode=OneWay, StringFormat={}{0:+0;-0;0} dB}"/>
                                                <Run Text="  /  DT "/><Run Text="{Binding TimeOffsetSeconds, Mode=OneWay, StringFormat={}{0:F1} s}"/>
                                                <Run Text="  /  バンド "/><Run Text="{Binding BandFrequencyText, Mode=OneWay}"/>
                                                <Run Text="  /  音声 "/><Run Text="{Binding AudioFrequencyHz, Mode=OneWay}"/><Run Text=" Hz"/>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="まだ有効な弱信号デジタルメッセージを受信していません">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PluginEmptyStateTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=Ft8HistoryGrid}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                </Border>
                <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"/>
                <controls:TimelineDetailPane Grid.Row="3" DetailContent="{Binding SelectedTimelineReception}"
                    EmptyText="時系列の復号結果を選択すると、スロットとデコード詳細が表示されます">
                    <controls:TimelineDetailPane.DetailContentTemplate><DataTemplate><StackPanel Margin="4,2">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FromCall}" Style="{DynamicResource PluginIdentityTextStyle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding LocalReceivedAt, StringFormat={}{0:yyyy/MM/dd HH:mm:ss.fff}}" Style="{DynamicResource PluginTimelineDetailTimestampStyle}"/>
                        </Grid>
                        <UniformGrid Columns="4" Margin="0,4,0,2">
                            <StackPanel><TextBlock Text="宛先 / 種別" Style="{DynamicResource PluginTimelineDetailLabelStyle}"/><TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}"><Run Text="{Binding ToCall, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding MessageType, Mode=OneWay}"/></TextBlock></StackPanel>
                            <StackPanel><TextBlock Text="モード / SNR" Style="{DynamicResource PluginTimelineDetailLabelStyle}"/><TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}"><Run Text="{Binding Mode, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding SnrDb, StringFormat={}{0:+0;-0;0} dB}"/></TextBlock></StackPanel>
                            <StackPanel><TextBlock Text="時刻差 / 同期" Style="{DynamicResource PluginTimelineDetailLabelStyle}"/><TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}"><Run Text="{Binding TimeOffsetSeconds, StringFormat={}{0:F1} s}"/><Run Text=" / "/><Run Text="{Binding SyncScore, Mode=OneWay}"/></TextBlock></StackPanel>
                            <StackPanel><TextBlock Text="無線周波数 / 音声周波数" Style="{DynamicResource PluginTimelineDetailLabelStyle}"/><TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}"><Run Text="{Binding BandFrequencyText, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding AudioFrequencyHz, Mode=OneWay}"/><Run Text=" Hz"/></TextBlock></StackPanel>
                        </UniformGrid>
                        <TextBox Text="{Binding Message, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" />
                        <Expander Header="ペイロード (HEX)" Style="{DynamicResource PluginTimelineExpanderStyle}">
                            <TextBlock Text="{Binding PayloadHex}" Style="{DynamicResource PluginTimelineDetailValueStyle}" TextWrapping="Wrap"/>
                        </Expander>
                    </StackPanel></DataTemplate></controls:TimelineDetailPane.DetailContentTemplate>
                </controls:TimelineDetailPane>
                </Grid>
            </TabItem>

            <TabItem Header="地図">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Margin="8,6" Padding="4">
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}" FontSize="10">
                            <Run Text="表示対象: 復号メッセージ内のMaidenheadグリッドロケーター　| 　表示局数: "/><Run Text="{Binding MapMarkers.Count, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/><Run Text=" 局"/>
                        </TextBlock>
                    </Border>
                    <Border Grid.Row="1" Margin="4" Background="{DynamicResource PanelBaseBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="2" ClipToBounds="True">
                        <Grid>
                            <wpf:GeoMapView MapId="ft8" LegendHtml="{x:Static ft8:Ft8MapPresentation.LegendHtml}" ShowTrailToggle="False" LabelToggleText="コールサイン" ItemsSource="{Binding MapMarkers}"/>
                            <TextBlock Text="グリッドロケーターを含むメッセージを受信すると、ここに表示されます。">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PluginEmptyStateTextStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MapMarkers.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="診断">
                <DockPanel Margin="12,10" LastChildFill="True">
                    <controls:DiagnosticsOverview DockPanel.Dock="Top"
                        StatusKind="{Binding OverallStatusKind}"
                        StatusText="{Binding OverallStatusText}"
                        PhaseText="{Binding OverallPhase, StringFormat=段階: {0}}"
                        LastUpdatedText="{Binding OverallLastUpdated, StringFormat=更新 {0}}"
                        SummaryText="{Binding OverallSummary}"
                        RecommendationText="{Binding OverallRecommendation}"
                        RuntimeDiagnostics="{Binding RuntimeDiagnostics}"
                        ChannelText="{Binding DialFrequencyText, StringFormat=対象 {0}}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="760">
                        <Expander Header="リアルタイム処理" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                            <controls:RuntimeDiagnosticsDetails RuntimeDiagnostics="{Binding RuntimeDiagnostics}" />
                        </Expander>
                        <Expander Header="入力・選局" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                        <Border Style="{DynamicResource PluginMetricCardStyle}" Margin="0">
                        <StackPanel>
                        <TextBlock Text="入力・選局" Style="{DynamicResource PluginSecondarySectionHeaderStyle}"/>
                        <Grid Margin="0,5,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="入力サンプルレート" Foreground="{DynamicResource TextDimBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding InputRate}" Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="{DynamicResource DisplayFontFamily}"/>
                            <TextBlock Grid.Row="1" Text="選局" Foreground="{DynamicResource TextDimBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DialFrequencyText}" Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="{DynamicResource DisplayFontFamily}"/>
                            <TextBlock Grid.Row="2" Text="対象帯域" Foreground="{DynamicResource TextDimBrush}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PassbandStatusText}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="3" Text="レート変換" Foreground="{DynamicResource TextDimBrush}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RateConversionText}" Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="{DynamicResource DisplayFontFamily}"/>
                            <TextBlock Grid.Row="4" Text="IQ入力 → 中間 → 復調レート" Foreground="{DynamicResource TextDimBrush}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RatePathText}" Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="{DynamicResource DisplayFontFamily}" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="5" Text="時刻・スロット境界" Foreground="{DynamicResource TextDimBrush}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SlotTimingText}" Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="{DynamicResource DisplayFontFamily}" TextWrapping="Wrap"/>
                        </Grid>
                        </StackPanel>
                        </Border>
                        </Expander>
                        <Expander Header="信号・チャネル" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                            <Border Style="{DynamicResource PluginMetricCardStyle}" Margin="0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                                    <TextBlock Text="チャネルレベル" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Grid.Column="1" Text="{Binding ChannelLevelText}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                    <TextBlock Grid.Row="1" Text="探索音声帯域" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="200–3000 Hz" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                    <TextBlock Grid.Row="2" Text="同期スコアしきい値" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MinimumSyncScore}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                </Grid>
                            </Border>
                        </Expander>
                        <Expander Header="検出・同期・復調" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                            <StackPanel Margin="8,5">
                                <TextBlock Text="{Binding RecentDetectionText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                <TextBlock Text="{Binding Buffered}" Foreground="{DynamicResource TextDimBrush}" FontFamily="{DynamicResource DisplayFontFamily}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Expander>
                        <Expander Header="検証・復号" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                        <Border Style="{DynamicResource PluginMetricCardStyle}" Margin="0">
                        <StackPanel>
                        <TextBlock Text="検証・復号" Style="{DynamicResource PluginSecondarySectionHeaderStyle}"/>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="直近スロット" Foreground="{DynamicResource TextDimBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding RecentValidationText}" Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="{DynamicResource DisplayFontFamily}"/>
                            <TextBlock Grid.Row="1" Text="累積（統計リセット以降）" Foreground="{DynamicResource TextDimBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"><Run Text="候補 "/><Run Text="{Binding Candidates, Mode=OneWay}"/><Run Text=" / FEC棄却 "/><Run Text="{Binding Rejected, Mode=OneWay}"/></TextBlock>
                            <TextBlock Grid.Row="2" Text="直前の復号時間" Foreground="{DynamicResource TextDimBrush}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DecodeTime}" Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="{DynamicResource DisplayFontFamily}"/>
                        </Grid>
                        </StackPanel>
                        </Border>
                        </Expander>
                        <Expander Header="詳細・デバッグ" Style="{DynamicResource PluginDiagnosticsSectionStyle}" IsExpanded="False">
                            <StackPanel Margin="8,5">
                                <TextBlock Foreground="{DynamicResource TextDimBrush}"><Run Text="候補上限 "/><Run Text="{Binding MaximumCandidates, Mode=OneWay}"/><Run Text=" / LDPC iteration "/><Run Text="{Binding LdpcIterations, Mode=OneWay}"/></TextBlock>
                                <Button Content="診断統計をリセット" Command="{Binding ResetDiagnosticStatisticsCommand}" Width="120" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
