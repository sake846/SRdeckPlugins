<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SRdeckPlugin.Contracts\SRdeckPlugin.Contracts.csproj" />
    <ProjectReference Include="..\SRdeckPlugin.Sdk\SRdeckPlugin.Sdk.csproj" />
    <ProjectReference Include="..\SRdeckCore.SignalProcessing\SRdeckCore.SignalProcessing.csproj" />
    <ProjectReference Include="..\SRdeckPlugin.Wpf\SRdeckPlugin.Wpf.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Bands.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          TargetPath="SRdeckPlugin.Ft8.bands.json" />
    <EmbeddedResource Include="Bands.json" LogicalName="SRdeckPlugin.Ft8.Bands.json" />
  </ItemGroup>
  <Target Name="CopyFt8ThirdPartyNotices" AfterTargets="Build;Publish">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\THIRD-PARTY-NOTICES.md"
          DestinationFiles="$(OutDir)SRdeckPlugin.Ft8.THIRD-PARTY-NOTICES.md"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\THIRD-PARTY-NOTICES.md"
          DestinationFiles="$(PublishDir)SRdeckPlugin.Ft8.THIRD-PARTY-NOTICES.md"
          SkipUnchangedFiles="true"
          Condition="'$(PublishDir)' != ''" />
  </Target>
</Project>
