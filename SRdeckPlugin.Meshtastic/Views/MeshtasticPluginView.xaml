<UserControl x:Class="SRdeckPlugin.Meshtastic.Views.MeshtasticPluginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SRdeckPlugin.Meshtastic.Views"
             xmlns:meshtastic="clr-namespace:SRdeckPlugin.Meshtastic"
             xmlns:wpf="clr-namespace:SRdeckPlugin.Wpf;assembly=SRdeckPlugin.Wpf"
             xmlns:controls="clr-namespace:SRdeckPlugin.Wpf.Controls;assembly=SRdeckPlugin.Wpf">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SRdeckPlugin.Meshtastic;component/Views/MeshtasticStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="OverflowTextStyle" TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
                <Setter Property="ToolTipService.ShowDuration" Value="60000" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <views:MeshtasticSettingsView Grid.Row="0" />

        <Border Grid.Row="1" Style="{StaticResource MeshtasticPanelStyle}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Margin="6,6,6,6" TextElement.FontSize="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource MeshtasticPanelHeaderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Style="{DynamicResource PluginStatusIndicatorStyle}" Tag="{Binding MeshtasticReceiverStatusKind}" />
                                <TextBlock Text="受信状態" Style="{StaticResource MeshtasticPanelTitleStyle}" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="クリア"
                                    Width="54" Margin="4,0,0,0"
                                    Command="{Binding ClearMeshtasticMessagesCommand}" />
                        </Grid>
                    </Border>

                    <TabControl Grid.Row="1" Style="{DynamicResource PluginTabControlStyle}" Padding="0"
                                MinHeight="0" VerticalContentAlignment="Stretch"
                                Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10">
                        <TabItem Header="概要">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="10,8">
                                    <TextBlock Text="最近受信したノード" Style="{DynamicResource PluginPrimarySectionHeaderStyle}" Margin="2,2,0,5" />
                                    <Border Background="{DynamicResource PanelBaseBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,8,8,4" Margin="0,0,0,4">
                                        <Grid>
                                            <ListBox ItemsSource="{Binding MeshtasticNodes}" MaxHeight="100" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" IsHitTestVisible="False">
                                                 <ListBox.ItemTemplate>
                                                     <DataTemplate>
                                                         <Grid Margin="3,2">
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="Auto" />
                                                                 <ColumnDefinition Width="Auto" />
                                                                 <ColumnDefinition Width="*" />
                                                             </Grid.ColumnDefinitions>

                                                             <TextBlock Grid.Column="0" Text="{Binding LastSeenTime}" Foreground="{DynamicResource TextDimBrush}" FontSize="10" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center" Margin="0,0,8,0" />

                                                             <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                 <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource PluginDisplayAccentTertiaryBrush}" FontSize="10" FontWeight="Bold" FontFamily="{DynamicResource MainFontFamily}" Margin="0,0,5,0" VerticalAlignment="Center" Style="{StaticResource OverflowTextStyle}" />
                                                                 <TextBlock Text="{Binding NodeId}" Foreground="{DynamicResource TextDimBrush}" FontSize="9.5" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center" Style="{StaticResource OverflowTextStyle}" />
                                                             </StackPanel>

                                                             <TextBlock Grid.Column="2" Text="{Binding LastSummaryText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" FontFamily="{DynamicResource DisplayFontFamily}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding LastSummaryText}" />
                                                         </Grid>
                                                     </DataTemplate>
                                                 </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock Text="確認済みノードはありません。" Foreground="{DynamicResource TextDimBrush}" FontSize="10" Margin="12,16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MeshtasticNodes.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="最近受信したテキストメッセージ" Style="{DynamicResource PluginPrimarySectionHeaderStyle}" Margin="2,12,0,5" />
                                    <Border Background="{DynamicResource PanelBaseBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,8,8,2" Margin="0,0,0,4">
                                        <Grid>
                                            <ListBox ItemsSource="{Binding MeshtasticTextMessages}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Focusable" Value="False" />
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="Margin" Value="0" />
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource PanelSurfaceBrush}"
                                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4,10,10,10"
                                                                Padding="9,7"
                                                                Margin="0,0,0,6">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>

                                                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Border Background="{DynamicResource PluginDisplayAccentPrimaryBrush}"
                                                                                Width="16" Height="16" CornerRadius="8" Margin="0,0,6,0"
                                                                                VerticalAlignment="Center">
                                                                            <TextBlock Text="💬" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                                                        </Border>
                                                                        <TextBlock Text="{Binding SenderName}" Foreground="{DynamicResource PluginDisplayAccentTertiaryBrush}" FontSize="10" FontWeight="Bold" FontFamily="{DynamicResource MainFontFamily}" Margin="0,0,5,0" Style="{StaticResource OverflowTextStyle}" />
                                                                        <TextBlock Text="{Binding Sender}" Foreground="{DynamicResource TextDimBrush}" FontSize="10" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource OverflowTextStyle}" />
                                                                    </StackPanel>

                                                                    <TextBlock Grid.Column="1" Text="{Binding ReceivedDateTimeSingleLineText}" Foreground="{DynamicResource TextDimBrush}" FontSize="10" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center" />
                                                                </Grid>

                                                                <TextBlock Grid.Row="1" Text="{Binding Summary}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" FontFamily="{DynamicResource MainFontFamily}" TextWrapping="Wrap" LineHeight="14" Margin="22,0,0,4" />

                                                                <WrapPanel Grid.Row="2" Margin="22,2,0,0" VerticalAlignment="Center">
                                                                    <Border Background="{DynamicResource InstrumentBaseBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,5,2">
                                                                        <TextBlock Text="{Binding RelayText}" Foreground="{DynamicResource TextDimBrush}" FontSize="9" FontFamily="{DynamicResource DisplayFontFamily}" />
                                                                    </Border>

                                                                    <Border Background="{DynamicResource InstrumentBaseBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,5,2" ToolTip="{Binding Radio}">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="📻 " FontSize="8.5" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding SlotAndPresetText}" Foreground="{DynamicResource PluginDisplayAccentSecondaryBrush}" FontSize="9" FontFamily="{DynamicResource DisplayFontFamily}" FontWeight="SemiBold" />
                                                                        </StackPanel>
                                                                    </Border>

                                                                    <Border Background="{DynamicResource InstrumentBaseBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,5,2" ToolTip="{Binding Quality}">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="⚡ " FontSize="8.5" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding SignalQualityText}" Foreground="{DynamicResource TextDimBrush}" FontSize="9" FontFamily="{DynamicResource DisplayFontFamily}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </WrapPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock Text="テキストメッセージはありません。" Foreground="{DynamicResource TextDimBrush}" FontSize="10" Margin="12,16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding MeshtasticTextMessages.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="一覧">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="0" />
                                    <RowDefinition Height="5" />
                                    <RowDefinition Height="190" MinHeight="112" MaxHeight="280" />
                                </Grid.RowDefinitions>
                                <StackPanel Margin="8,6,8,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ノード別" Foreground="{DynamicResource PluginDisplayAccentPrimaryBrush}"
                                                   FontSize="10" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="検索" Style="{DynamicResource PluginListSearchLabelStyle}" />
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding MeshtasticNodeSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="ノード名、Node ID、ハードウェア、役割を検索"
                                                 Style="{DynamicResource PluginListSearchTextBoxStyle}" />
                                    </Grid>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <WrapPanel>
                                            <CheckBox Content="活動中" IsChecked="{Binding MeshtasticNodesActiveOnly}"
                                                      Style="{DynamicResource PluginCheckBoxStyle}" Margin="0,0,4,0" />
                                            <CheckBox Content="直接受信あり" IsChecked="{Binding MeshtasticNodesDirectOnly}"
                                                      Style="{DynamicResource PluginCheckBoxStyle}" Margin="0,0,4,0" />
                                            <CheckBox Content="位置あり" IsChecked="{Binding MeshtasticNodesWithPositionOnly}"
                                                      Style="{DynamicResource PluginCheckBoxStyle}" />
                                        </WrapPanel>
                                        <TextBlock Grid.Column="1" Foreground="{DynamicResource TextDimBrush}"
                                                   FontFamily="{DynamicResource DisplayFontFamily}" FontSize="10"
                                                   VerticalAlignment="Center" Margin="8,0,0,0">
                                            <Run Text="表示 "/><Run Text="{Binding FilteredMeshtasticNodes.Count, Mode=OneWay}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/><Run Text=" 件"/>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                                <Border Grid.Row="1" Style="{DynamicResource PluginTimelineBorderStyle}">
                                    <Grid>
                                        <DataGrid x:Name="MeshtasticNodeDataGrid"
                                                  ItemsSource="{Binding FilteredMeshtasticNodes}"
                                                  SelectedItem="{Binding SelectedMeshtasticNode, Mode=TwoWay}"
                                                  Style="{DynamicResource PluginTimelineDataGridStyle}">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="最終受信" Width="82" SortMemberPath="LastSeenAt" SortDirection="Descending"
                                                                        CellStyle="{DynamicResource PluginTimelineTimestampCellStyle}">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding LastSeenDateTimeText}"
                                                                           Style="{DynamicResource PluginTimelineTimestampTextStyle}"
                                                                           LineHeight="13" ToolTip="{Binding LastSeenDateTimeText}" />
                                                                <TextBlock Text="{Binding ActivityStatus}"
                                                                           Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="ノード" Width="*" MinWidth="200" SortMemberPath="DisplayName">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2,0,3" ToolTip="{Binding Details}"
                                                                  TextElement.FontFamily="{DynamicResource DisplayFontFamily}">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                               Style="{DynamicResource PluginTimelineIdentityTextStyle}"
                                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding NodeId}" Margin="8,0,0,0"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                </Grid>
                                                                <TextBlock Grid.Row="1" Foreground="{DynamicResource TextDimBrush}"
                                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Identity}">
                                                                    <Run Text="{Binding Identity, Mode=OneWay}"/><Run Text="  /  "/><Run Text="{Binding Route, Mode=OneWay}"/>
                                                                </TextBlock>
                                                                <TextBlock Grid.Row="2" Text="{Binding LastSummaryText}" Margin="0,2,0,0"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           TextWrapping="Wrap" ToolTip="{Binding LastSummaryText}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="条件に一致するノードがありません。">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource PluginEmptyStateTextStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasItems, ElementName=MeshtasticNodeDataGrid}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                                              Background="Transparent" ResizeDirection="Rows" />
                                <controls:SelectionDetailPane Grid.Row="3" DetailContent="{Binding SelectedMeshtasticNode}"
                                    EmptyText="一覧からノードを選択すると、識別情報と最近の受信内容が表示されます">
                                    <controls:SelectionDetailPane.DetailContentTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,2">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*" MinWidth="120" />
                                                    <ColumnDefinition Width="6" />
                                                    <ColumnDefinition Width="3*" MinWidth="220" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,8,4">
                                                    <TextBlock Text="{Binding DisplayName}" Style="{DynamicResource PluginIdentityTextStyle}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding NodeId}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="このノードの受信履歴"
                                                           Style="{DynamicResource PluginSecondarySectionHeaderStyle}" Margin="8,0,0,4"/>
                                                <GridSplitter Grid.Column="1" Grid.RowSpan="2"
                                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                              Background="Transparent" ResizeDirection="Columns"
                                                              ResizeBehavior="PreviousAndNext" Cursor="SizeWE" />
                                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <StackPanel Margin="0,0,8,0">
                                                        <TextBlock Text="識別" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/>
                                                        <TextBlock Text="{Binding Identity}" Style="{DynamicResource PluginTimelineDetailValueStyle}" TextWrapping="Wrap"/>
                                                        <TextBlock Text="受信モード / 経路" Style="{DynamicResource PluginSelectionDetailLabelStyle}" Margin="0,5,0,0"/>
                                                        <TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}" TextWrapping="Wrap"><Run Text="{Binding Mode, Mode=OneWay}"/><Run Text="  /  "/><Run Text="{Binding Route, Mode=OneWay}"/></TextBlock>
                                                        <TextBlock Text="位置 / テレメトリ" Style="{DynamicResource PluginSelectionDetailLabelStyle}" Margin="0,5,0,0"/>
                                                        <TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}" TextWrapping="Wrap"><Run Text="{Binding Position, Mode=OneWay}"/><Run Text="  /  "/><Run Text="{Binding Telemetry, Mode=OneWay}"/></TextBlock>
                                                        <TextBlock Text="受信統計 / 信号品質" Style="{DynamicResource PluginSelectionDetailLabelStyle}" Margin="0,5,0,0"/>
                                                        <TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}" TextWrapping="Wrap"><Run Text="{Binding Counts, Mode=OneWay}"/><Run Text="  /  "/><Run Text="{Binding SignalQuality, Mode=OneWay}"/></TextBlock>
                                                        <TextBlock Text="最新メッセージ" Style="{DynamicResource PluginSelectionDetailLabelStyle}" Margin="0,5,0,0"/>
                                                        <TextBlock Text="{Binding LastMessage}" Style="{DynamicResource PluginTimelineDetailValueStyle}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </ScrollViewer>
                                                <ListBox Grid.Row="1" Grid.Column="2"
                                                         ItemsSource="{Binding DataContext.SelectedMeshtasticNodeReceptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         Background="{DynamicResource PanelBaseBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1,0,0,0"
                                                         Foreground="{DynamicResource TextPrimaryBrush}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Focusable" Value="False"/></Style></ListBox.ItemContainerStyle>
                                                    <ListBox.ItemTemplate><DataTemplate>
                                                        <Grid Margin="7,3">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="92"/><ColumnDefinition Width="76"/><ColumnDefinition Width="*" MinWidth="120"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding ReceivedTime}" Foreground="{DynamicResource TextDimBrush}" FontSize="10" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Transmission}" Style="{StaticResource OverflowTextStyle}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Route}" Style="{StaticResource OverflowTextStyle}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding Summary}" Style="{StaticResource OverflowTextStyle}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10"/>
                                                        </Grid>
                                                    </DataTemplate></ListBox.ItemTemplate>
                                                </ListBox>
                                            </Grid>
                                        </DataTemplate>
                                    </controls:SelectionDetailPane.DetailContentTemplate>
                                </controls:SelectionDetailPane>
                            </Grid>
                        </TabItem>

                        <TabItem x:Name="MeshtasticTimelineTab" Header="時系列">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition Height="170" MinHeight="96" MaxHeight="280"/></Grid.RowDefinitions>
                                <StackPanel Margin="8,6,8,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="時系列順" Foreground="{DynamicResource PluginDisplayAccentPrimaryBrush}"
                                                   FontSize="10" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="検索" Style="{DynamicResource PluginListSearchLabelStyle}" />
                                        <TextBox Grid.Column="2"
                                                 Text="{Binding MeshtasticHistorySearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="ノード名、Node ID、Packet ID、Port、内容を検索"
                                                 Style="{DynamicResource PluginListSearchTextBoxStyle}" />
                                    </Grid>
                                    <WrapPanel Margin="0,4,0,0">
                                        <CheckBox Content="復号済みのみ" IsChecked="{Binding MeshtasticHistoryDecodedOnly}"
                                                  Style="{DynamicResource PluginCheckBoxStyle}" Margin="0,0,4,0" />
                                        <CheckBox Content="直接受信のみ" IsChecked="{Binding MeshtasticHistoryDirectOnly}"
                                                  Style="{DynamicResource PluginCheckBoxStyle}" />
                                    </WrapPanel>
                                </StackPanel>
                                <Border Grid.Row="1" Style="{DynamicResource PluginTimelineBorderStyle}">
                                    <Grid>
                                         <DataGrid x:Name="MeshtasticTimelineDataGrid"
                                                   ItemsSource="{Binding VisibleMeshtasticMessages}"
                                                   SelectedItem="{Binding SelectedTimelineMessage, Mode=TwoWay}"
                                                   Style="{DynamicResource PluginTimelineDataGridStyle}">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="日時" Width="82" SortMemberPath="ReceivedAt"
                                                                        CellStyle="{DynamicResource PluginTimelineTimestampCellStyle}">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding ReceivedDateTimeText}"
                                                                       Style="{DynamicResource PluginTimelineTimestampTextStyle}"
                                                                       LineHeight="13"
                                                                       VerticalAlignment="Top" Margin="0,2,0,0"
                                                                       ToolTip="{Binding ReceivedDateTimeText}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="受信イベント" Width="*" MinWidth="200" SortMemberPath="SenderName">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,2,0,3"
                                                                  TextElement.FontFamily="{DynamicResource DisplayFontFamily}">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding SenderName}"
                                                                               Style="{DynamicResource PluginTimelineIdentityTextStyle}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding SenderName}" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding RelayText}" Margin="8,0,0,0"
                                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding RelayText}" />
                                                                </Grid>
                                                                <TextBlock Grid.Row="1" Foreground="{DynamicResource TextDimBrush}"
                                                                           Margin="0,2,0,0" TextWrapping="Wrap">
                                                                    <Run Text="Node "/><Run Text="{Binding Sender, Mode=OneWay}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                                    <Run Text="  /  Packet "/><Run Text="{Binding PacketIdText, Mode=OneWay}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                                    <Run Text="  /  "/><Run Text="{Binding Port, Mode=OneWay}"/>
                                                                </TextBlock>
                                                                <TextBlock Grid.Row="2" Text="{Binding Summary}" Margin="0,2,0,0"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           TextWrapping="Wrap" ToolTip="{Binding Details}" />
                                                                <TextBlock Grid.Row="3" Foreground="{DynamicResource TextDimBrush}"
                                                                           Margin="0,2,0,0" TextWrapping="Wrap">
                                                                    <Run Text="{Binding Radio, Mode=OneWay}"/><Run Text="  /  "/><Run Text="{Binding Quality, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="条件に一致する履歴はありません。">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource PluginEmptyStateTextStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasItems, ElementName=MeshtasticTimelineDataGrid}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                 </Border>
                                <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"/>
                                <controls:TimelineDetailPane Grid.Row="3" DetailContent="{Binding SelectedTimelineMessage}"
                                    EmptyText="時系列のパケットを選択すると、経路・復号・無線条件の詳細が表示されます">
                                    <controls:TimelineDetailPane.DetailContentTemplate><DataTemplate><StackPanel Margin="4,2">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SenderName}" Style="{DynamicResource PluginIdentityTextStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ReceivedDateTimeText}" Style="{DynamicResource PluginTimelineDetailTimestampStyle}"/>
                                        </Grid>
                                        <UniformGrid Columns="4" Margin="0,4,0,2">
                                            <StackPanel><TextBlock Text="ノード / パケット" Style="{DynamicResource PluginTimelineDetailLabelStyle}"/><TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}"><Run Text="{Binding Sender, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding PacketIdText, Mode=OneWay}"/></TextBlock></StackPanel>
                                            <StackPanel><TextBlock Text="Port / 経路" Style="{DynamicResource PluginTimelineDetailLabelStyle}"/><TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}"><Run Text="{Binding Port, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding RelayText, Mode=OneWay}"/></TextBlock></StackPanel>
                                            <StackPanel><TextBlock Text="無線" Style="{DynamicResource PluginTimelineDetailLabelStyle}"/><TextBlock Text="{Binding SlotAndPresetText}" Style="{DynamicResource PluginTimelineDetailValueStyle}"/></StackPanel>
                                            <StackPanel><TextBlock Text="品質 / CRC" Style="{DynamicResource PluginTimelineDetailLabelStyle}"/><TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}"><Run Text="{Binding Quality, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding PayloadCrcValid, Mode=OneWay}"/></TextBlock></StackPanel>
                                        </UniformGrid>
                                        <TextBlock Text="{Binding Details}" Style="{DynamicResource PluginTimelineDetailValueStyle}" Margin="0,4,0,0"/>
                                        <Expander Header="ペイロード (HEX)" Style="{DynamicResource PluginTimelineExpanderStyle}">
                                            <TextBlock Text="{Binding PayloadHex}" Style="{DynamicResource PluginTimelineDetailValueStyle}" TextWrapping="Wrap"/>
                                        </Expander>
                                    </StackPanel></DataTemplate></controls:TimelineDetailPane.DetailContentTemplate>
                                </controls:TimelineDetailPane>
                            </Grid>
                        </TabItem>

                        <TabItem Header="地図">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Margin="8,6" Padding="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="表示:" Foreground="{DynamicResource TextDimBrush}" FontSize="10" Margin="0,0,9,0" />
                                            <CheckBox Content="活動中のみ" IsChecked="{Binding MeshtasticMapActiveOnly}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0" />
                                            <CheckBox Content="直接受信あり" IsChecked="{Binding MeshtasticMapDirectOnly}"
                                                      Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextDimBrush}" FontSize="10">
                                            <Run Text="表示ノード数: "/><Run Text="{Binding MapMarkers.Count, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/><Run Text=" 件"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Margin="4" Background="{DynamicResource PanelBaseBrush}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="2"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        ClipToBounds="True">
                                    <Grid>
                                        <wpf:GeoMapView x:Name="MeshtasticGeoMap" MapId="meshtastic"
                                                        ItemsSource="{Binding MapMarkers}"
                                                        LegendHtml="{x:Static meshtastic:MeshtasticMapPresentation.LegendHtml}"
                                                        ShowTrailToggle="False"
                                                        LabelToggleText="ノード名"
                                                        UseCalloutLabels="True"
                                                        MarkerInvokedCommand="{Binding SelectMeshtasticMapMarkerCommand}" />
                                        <TextBlock Text="位置情報を持つノードがまだありません。">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource PluginEmptyStateTextStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MapMarkers.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="診断">
                            <DockPanel Margin="10,8" LastChildFill="True">
                                <controls:DiagnosticsOverview DockPanel.Dock="Top"
                                    StatusKind="{Binding MeshtasticDiagnosticStatusKind}"
                                    StatusText="{Binding MeshtasticDiagnosticStatusText}"
                                    PhaseText="{Binding MeshtasticDiagnosticPhase, StringFormat=段階: {0}}"
                                    LastUpdatedText="{Binding MeshtasticDiagnosticLastUpdated, StringFormat=更新 {0}}"
                                    SummaryText="{Binding MeshtasticDiagnosticSummary}"
                                    RecommendationText="{Binding MeshtasticDiagnosticRecommendation}"
                                    RuntimeDiagnostics="{Binding RuntimeDiagnostics}"
                                    ChannelText="{Binding MeshtasticPassbandStatus}" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                <Expander Header="リアルタイム処理" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                    <controls:RuntimeDiagnosticsDetails RuntimeDiagnostics="{Binding RuntimeDiagnostics}" />
                                </Expander>
                                <Expander Header="入力・選局" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                    <Border Style="{DynamicResource PluginMetricCardStyle}" Margin="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Text="監視設定" Foreground="{DynamicResource TextDimBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding MeshtasticDiagnosticTuningText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="1" Text="対象帯域" Foreground="{DynamicResource TextDimBrush}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MeshtasticPassbandStatus}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Grid.Row="2" Text="レート変換" Foreground="{DynamicResource TextDimBrush}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MeshtasticRateConversionText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                            <TextBlock Grid.Row="3" Text="IQ入力 → 中間 → 復調レート" Foreground="{DynamicResource TextDimBrush}"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MeshtasticRatePathText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </Expander>
                                <Expander Header="信号・チャネル" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                    <StackPanel Margin="8,5">
                                        <TextBlock Text="{Binding MeshtasticDiagnosticSignalText}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontFamily="{DynamicResource DisplayFontFamily}" TextWrapping="Wrap" />
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="周波数ずれ補正" Foreground="{DynamicResource TextDimBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding MeshtasticFrequencyCorrectionText}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontFamily="{DynamicResource DisplayFontFamily}" TextWrapping="Wrap"/>
                                        </Grid>
                                        <TextBlock Text="{Binding MeshtasticLastFailureStatus}" Foreground="{DynamicResource TextDimBrush}"
                                                   Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander>
                                <Expander Header="検出・同期・復調"
                                          Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                            <Border Background="{DynamicResource PanelSurfaceBrush}" Padding="10,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                                        <TextBlock Text="現在の受信処理" Style="{DynamicResource PluginSecondarySectionHeaderStyle}"
                                                   Margin="0,0,0,6" />
                                        <TextBlock Text="{Binding MeshtasticPassbandStatus}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontFamily="{DynamicResource DisplayFontFamily}" FontSize="10" Margin="0,0,0,3" />
                                        <TextBlock Text="{Binding MeshtasticLastSignalStatus}" Foreground="{DynamicResource TextDimBrush}"
                                                   FontFamily="{DynamicResource DisplayFontFamily}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="22" />
                                                <RowDefinition Height="22" />
                                                <RowDefinition Height="22" />
                                                <RowDefinition Height="22" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="1. 信号を検出" Foreground="{DynamicResource TextDimBrush}" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MeshtasticPreambleCount}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" />
                                            <TextBlock Grid.Row="1" Text="2. タイミング同期" Foreground="{DynamicResource TextDimBrush}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MeshtasticSynchronizedCount}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" />
                                            <TextBlock Grid.Row="2" Text="3. ヘッダーを読取" Foreground="{DynamicResource TextDimBrush}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MeshtasticHeaderCount}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" />
                                            <TextBlock Grid.Row="3" Text="4. 本文を読取" Foreground="{DynamicResource TextDimBrush}" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MeshtasticPayloadCount}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" />
                                        </Grid>
                                    </StackPanel>
                                    <Expander Grid.Row="1" Grid.ColumnSpan="2" Header="詳細・デバッグ（LoRa内部処理）"
                                              IsExpanded="False" Foreground="{DynamicResource TextDimBrush}"
                                              BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,1,0,0"
                                              Margin="0,7,0,0" Padding="0,7,0,0">
                                        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Margin="8,5,5,0">
                                            <TextBlock Text="受信漏れや動作の重さを調べるための情報です。まず総合状態を確認し、必要な項目だけ参照してください。"
                                                       Foreground="{DynamicResource TextDimBrush}" FontSize="10"
                                                       TextWrapping="Wrap" Margin="0,0,0,6" />
                                            <Border Background="{DynamicResource PanelSurfaceBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                                    CornerRadius="3" Padding="8,6" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="総合状態" Foreground="{DynamicResource TextDimBrush}" FontSize="10" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding MeshtasticPerformanceStatus}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   FontSize="11" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding MeshtasticPerformanceDetails}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <GroupBox Header="失敗の内訳" Foreground="{DynamicResource TextDimBrush}" FontSize="10">
                                                    <StackPanel Margin="5,2">
                                                        <UniformGrid Columns="4">
                                                            <StackPanel><TextBlock Text="同期" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Text="{Binding MeshtasticSyncFailureCount}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" FontSize="14"/></StackPanel>
                                                            <StackPanel><TextBlock Text="信号終端" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Text="{Binding MeshtasticSfdFailureCount}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" FontSize="14"/></StackPanel>
                                                            <StackPanel><TextBlock Text="ヘッダー" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Text="{Binding MeshtasticHeaderFailureCount}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" FontSize="14"/></StackPanel>
                                                            <StackPanel><TextBlock Text="本文" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Text="{Binding MeshtasticPayloadFailureCount}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" FontSize="14"/></StackPanel>
                                                        </UniformGrid>
                                                        <TextBlock Text="{Binding MeshtasticLastFailureStatus}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                                                    </StackPanel>
                                                </GroupBox>
                                                <GroupBox Grid.Column="2" Header="処理待ち・保留" Foreground="{DynamicResource TextDimBrush}" FontSize="10">
                                                    <Grid Margin="5,2">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                                                        <TextBlock Text="処理待ち件数" Foreground="{DynamicResource TextDimBrush}"/>
                                                        <TextBlock Grid.Column="1" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"><Run Text="現在 "/><Run Text="{Binding MeshtasticQueueDepth, Mode=OneWay}"/><Run Text="　最大 "/><Run Text="{Binding MeshtasticMaximumQueueDepth, Mode=OneWay}"/></TextBlock>
                                                        <TextBlock Grid.Row="1" Text="保留時間" Foreground="{DynamicResource TextDimBrush}"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"><Run Text="最古 "/><Run Text="{Binding MeshtasticOldestDeferredIqMs, Mode=OneWay, StringFormat=F0}"/><Run Text=" ms　残り "/><Run Text="{Binding MeshtasticDeferredRetentionRemainingMs, Mode=OneWay, StringFormat=F0}"/><Run Text=" ms"/></TextBlock>
                                                        <TextBlock Grid.Row="2" Text="保留後の結果" Foreground="{DynamicResource TextDimBrush}"/>
                                                        <TextBlock Grid.Row="2" Grid.Column="1" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"><Run Text="処理 "/><Run Text="{Binding MeshtasticDeferredRecoveredBlocks, Mode=OneWay}"/><Run Text="　期限切れ "/><Run Text="{Binding MeshtasticExpiredHistoryBlocks, Mode=OneWay}"/></TextBlock>
                                                    </Grid>
                                                </GroupBox>
                                            </Grid>
                                            <GroupBox Header="処理時間と負荷（現在 / 平均 / 最大）" Foreground="{DynamicResource TextDimBrush}"
                                                      FontSize="10" Margin="0,6,0,0">
                                                <UniformGrid Columns="4" Margin="5,3">
                                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="処理負荷" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"><Run Text="{Binding MeshtasticCurrentProcessingLoadPercent, Mode=OneWay, StringFormat=F1}"/><Run Text=" / "/><Run Text="{Binding MeshtasticAverageProcessingLoadPercent, Mode=OneWay, StringFormat=F1}"/><Run Text=" / "/><Run Text="{Binding MeshtasticMaximumProcessingLoadPercent, Mode=OneWay, StringFormat=F1}"/><Run Text=" %"/></TextBlock></StackPanel>
                                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="処理待ち時間" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"><Run Text="{Binding MeshtasticCurrentQueueDelayMs, Mode=OneWay, StringFormat=F2}"/><Run Text=" / "/><Run Text="{Binding MeshtasticAverageQueueDelayMs, Mode=OneWay, StringFormat=F2}"/><Run Text=" / "/><Run Text="{Binding MeshtasticMaximumQueueDelayMs, Mode=OneWay, StringFormat=F2}"/><Run Text=" ms"/></TextBlock></StackPanel>
                                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="1回の処理時間" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"><Run Text="{Binding MeshtasticCurrentProcessingTimeMs, Mode=OneWay, StringFormat=F2}"/><Run Text=" / "/><Run Text="{Binding MeshtasticAverageProcessingTimeMs, Mode=OneWay, StringFormat=F2}"/><Run Text=" / "/><Run Text="{Binding MeshtasticMaximumProcessingTimeMs, Mode=OneWay, StringFormat=F2}"/><Run Text=" ms"/></TextBlock></StackPanel>
                                                    <StackPanel><TextBlock Text="前処理CPU（平均）" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"><Run Text="帯域 "/><Run Text="{Binding MeshtasticAverageChannelizationCpuMs, Mode=OneWay, StringFormat=F2}"/><Run Text=" / 検出 "/><Run Text="{Binding MeshtasticAverageDetectionCpuMs, Mode=OneWay, StringFormat=F2}"/><Run Text=" ms"/></TextBlock><TextBlock Foreground="{DynamicResource TextDimBrush}" FontSize="10" Margin="0,1,0,0"><Run Text="入力間隔 "/><Run Text="{Binding MeshtasticCurrentInputBlockTimeMs, Mode=OneWay, StringFormat=F2}"/><Run Text=" ms"/></TextBlock></StackPanel>
                                                </UniformGrid>
                                            </GroupBox>
                                            <Button Content="診断値をリセット" Command="{Binding ResetMeshtasticStatisticsCommand}"
                                                    Width="90" HorizontalAlignment="Right" Margin="0,4,0,0"
                                                    FontSize="10" Focusable="False" IsTabStop="False" />
                                        </StackPanel>
                                        </ScrollViewer>
                                    </Expander>
                                </Grid>
                            </Border>
                                </Expander>
                                <Expander Header="検証・復号" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                    <Border Style="{DynamicResource PluginMetricCardStyle}" Margin="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="payload CRC合格 / 不一致" Foreground="{DynamicResource TextDimBrush}"/>
                                            <TextBlock Grid.Column="1" FontFamily="{DynamicResource DisplayFontFamily}"><Run Text="{Binding MeshtasticPayloadCrcOkCount, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding MeshtasticPayloadCrcErrorCount, Mode=OneWay}"/></TextBlock>
                                            <TextBlock Grid.Row="1" Text="識別したパケット" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MeshtasticPacketCount}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                            <TextBlock Grid.Row="2" Text="内容を読めた数" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MeshtasticDataCount}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                            <TextBlock Grid.Row="3" Text="再受信（重複）" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MeshtasticDuplicateCount}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                            <TextBlock Grid.Row="4" Text="処理できなかった入力" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding MeshtasticDroppedBlockCount}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                        </Grid>
                                    </Border>
                                </Expander>
                                </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
    </Grid>
</UserControl>
