<UserControl x:Class="SRdeckPlugin.Meshtastic.Views.MeshtasticPluginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SRdeckPlugin.Meshtastic.Views"
             xmlns:meshtastic="clr-namespace:SRdeckPlugin.Meshtastic"
             xmlns:wpf="clr-namespace:SRdeckPlugin.Wpf;assembly=SRdeckPlugin.Wpf"
             xmlns:controls="clr-namespace:SRdeckPlugin.Wpf.Controls;assembly=SRdeckPlugin.Wpf">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SRdeckPlugin.Meshtastic;component/Views/MeshtasticViewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <views:MeshtasticSettingsView Grid.Row="0" />

        <Border x:Name="MeshtasticReceiverPanel" Grid.Row="1" Style="{StaticResource MeshtasticPanelStyle}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Margin="6,0,6,6" TextElement.FontSize="10"
                SizeChanged="OnReceiverPanelSizeChanged">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource MeshtasticPanelHeaderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Style="{DynamicResource PluginStatusIndicatorStyle}" Tag="{Binding MeshtasticReceiverStatusKind}" />
                                <TextBlock Text="受信状態" Style="{StaticResource MeshtasticPanelTitleStyle}" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="クリア"
                                    Width="54" Margin="4,0,0,0"
                                    Command="{Binding ClearMeshtasticMessagesCommand}" />
                        </Grid>
                    </Border>

                    <TabControl Grid.Row="1" Style="{DynamicResource PluginTabControlStyle}" Padding="0"
                                MinHeight="0" VerticalContentAlignment="Stretch"
                                Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10">
                        <TabItem Header="概要">
                            <views:MeshtasticOverviewView x:Name="OverviewView" />
                        </TabItem>
                        <TabItem Header="一覧">
                            <views:MeshtasticNodesView x:Name="NodesView" />
                        </TabItem>

                        <TabItem x:Name="MeshtasticTimelineTab" Header="時系列">
                            <views:MeshtasticTimelineView x:Name="TimelineView" />
                        </TabItem>

                        <TabItem Header="地図">
                            <views:MeshtasticMapView x:Name="MapView" />
                        </TabItem>

                        <TabItem Header="診断">
                            <views:MeshtasticDiagnosticsView x:Name="DiagnosticsView" />
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
    </Grid>
</UserControl>
