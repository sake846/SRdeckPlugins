<UserControl x:Class="SRdeckPlugin.Meshtastic.Views.MeshtasticMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{DynamicResource PanelBaseBrush}"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <UserControl.Resources>
        <ResourceDictionary Source="/SRdeckPlugin.Meshtastic;component/Views/MeshtasticStyles.xaml" />
    </UserControl.Resources>
    <Grid ClipToBounds="True" SizeChanged="OnMapSizeChanged">
        <wv2:WebView2 x:Name="_mapWebView" />
        <Border x:Name="_statusOverlay" Background="{DynamicResource PanelBaseBrush}" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18">
                <TextBlock Text="OpenStreetMap" Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="_statusText" Text="地図を初期化しています…"
                           Foreground="{DynamicResource TextDimBrush}" FontSize="10"
                           TextAlignment="Center" TextWrapping="Wrap" LineHeight="16" Margin="0,7,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
