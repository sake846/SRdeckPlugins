<UserControl x:Class="SRdeckPlugin.Meshtastic.Views.MeshtasticLinkQualityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="10">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SRdeckPlugin.Meshtastic;component/Views/MeshtasticViewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="0" />
        </Grid.RowDefinitions>
        <StackPanel Margin="10,8">
            <TextBlock Text="{Binding MeshtasticLinkQualityScope}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
            <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                       Text="ノード・地域・プリセット・スロット別に集計。SNR / RSSI は直接受信の有効値のみの推定値で、平均は dB 値の算術平均です。n は測定件数です。" />
            <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                       Text="時系列の絞り込みには連動しません。同一パケットの再受信も含みます。直接・中継の件数から到達率や損失率は算出できません。" />
            <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                       Text="直接受信と確認できない旧形式は経路不明として扱います。RSSI の dBm と dBFS は別々に集計します。" />
        </StackPanel>
        <Border Grid.Row="1" Style="{DynamicResource PluginTimelineBorderStyle}">
            <Grid>
                <DataGrid x:Name="LinkQualityGrid" ItemsSource="{Binding MeshtasticLinkQuality}"
                          HorizontalScrollBarVisibility="Auto"
                          Style="{DynamicResource PluginTimelineDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="ノード / 受信条件" Width="*" MinWidth="180" SortMemberPath="SenderName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3">
                                        <TextBlock Text="{Binding SenderName}" Style="{DynamicResource PluginTimelineIdentityTextStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SenderName}" />
                                        <TextBlock Text="{Binding Sender}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding RadioCondition}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding LastReceivedText}" Foreground="{DynamicResource TextDimBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="受信件数" Binding="{Binding ReceptionSummary}" Width="130" SortMemberPath="ReceptionCount" />
                        <DataGridTextColumn Header="直接 SNR" Binding="{Binding SnrSummary}" Width="190" SortMemberPath="DirectSnr.Average" />
                        <DataGridTemplateColumn Header="直接 RSSI" Width="210" SortMemberPath="DirectRssiDbm.Average">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3">
                                        <TextBlock Text="{Binding RssiDbmSummary}" />
                                        <TextBlock Text="{Binding RssiDbfsSummary}" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="受信すると、ノードごとのリンク品質を表示します。">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PluginEmptyStateTextStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=LinkQualityGrid}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
