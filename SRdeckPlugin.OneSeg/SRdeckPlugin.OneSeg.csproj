<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Platforms>x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SRdeckPlugin.Contracts\SRdeckPlugin.Contracts.csproj" />
    <ProjectReference Include="..\SRdeckPlugin.Sdk\SRdeckPlugin.Sdk.csproj" />
    <ProjectReference Include="..\SRdeckCore.SignalProcessing\SRdeckCore.SignalProcessing.csproj" />
    <ProjectReference Include="..\SRdeckPlugin.Wpf\SRdeckPlugin.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SRdeck.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>
  <Target Name="CopyOneSegThirdPartyNotices" AfterTargets="Build;Publish">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\THIRD-PARTY-NOTICES.md"
          DestinationFiles="$(OutDir)SRdeckPlugin.OneSeg.THIRD-PARTY-NOTICES.md"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\THIRD-PARTY-NOTICES.md"
          DestinationFiles="$(PublishDir)SRdeckPlugin.OneSeg.THIRD-PARTY-NOTICES.md"
          SkipUnchangedFiles="true"
          Condition="'$(PublishDir)' != ''" />
  </Target>
</Project>
