<UserControl x:Class="SRdeckPlugin.Hfdl.Views.HfdlPluginView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:views="clr-namespace:SRdeckPlugin.Hfdl.Views"
              xmlns:wpf="clr-namespace:SRdeckPlugin.Wpf;assembly=SRdeckPlugin.Wpf"
              xmlns:controls="clr-namespace:SRdeckPlugin.Wpf.Controls;assembly=SRdeckPlugin.Wpf">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <views:HfdlSettingsView Grid.Row="0"/>

        <Border Grid.Row="1" Style="{DynamicResource PluginFlatOuterPanelStyle}" Margin="6,0,6,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{DynamicResource PluginStatusHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Style="{DynamicResource PluginStatusIndicatorStyle}" Tag="{Binding OverallStatusKind}"/>
                            <TextBlock Text="受信状態" Style="{DynamicResource PluginStatusHeaderTitleStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="クリア" Command="{Binding ClearMessagesCommand}" Width="60" Height="26" FontSize="10"/>
                    </Grid>
                </Border>

                <TabControl Grid.Row="1" Style="{DynamicResource PluginTabControlStyle}" Padding="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10">
                    <!-- 1. 概要 -->
                    <TabItem Header="概要">
                        <Grid Margin="10,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="受信の概況" Style="{DynamicResource PluginSecondarySectionHeaderStyle}" Margin="2,0,0,5"/>
                            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,8">
                                <Border Style="{DynamicResource PluginMetricCardStyle}"><StackPanel><TextBlock Text="有効フレーム（累計）" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Text="{Binding ValidFrames, StringFormat=N0}" Foreground="{DynamicResource PluginDisplayAccentPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                                <Border Style="{DynamicResource PluginMetricCardStyle}"><StackPanel><TextBlock Text="識別できた便" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Text="{Binding IdentifiedFlightCount, StringFormat=N0}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                                <Border Style="{DynamicResource PluginMetricCardStyle}"><StackPanel><TextBlock Text="正常率（累計）" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Text="{Binding AcceptanceRateText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                                <Border Style="{DynamicResource PluginMetricCardStyle}"><StackPanel><TextBlock Text="最終受信" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Text="{Binding LastReceptionText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                            </UniformGrid>
                            <Border Grid.Row="2" Style="{DynamicResource PluginMetricCardStyle}" Padding="8,6">
                                <StackPanel>
                                    <TextBlock Text="受信成果" Style="{DynamicResource PluginPrimarySectionHeaderStyle}"/>
                                    <TextBlock Text="{Binding OverallSummary}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding OverallRecommendation}" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Grid.Row="3" Text="最近活動した便（便別集約・最大3件）" Style="{DynamicResource PluginSecondarySectionHeaderStyle}" Margin="2,2,0,5"/>
                            <ItemsControl Grid.Row="4" ItemsSource="{Binding RecentFlightGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,0,0,1" Padding="6,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="70"/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Key}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat={}{0:N0}件}" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="{Binding LastReceivedAt, StringFormat=HH:mm:ss}" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </TabItem>

                    <!-- 2. 一覧 -->
                    <TabItem Header="一覧">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="160" MinHeight="96" MaxHeight="260"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="8,6,8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="表示:" VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,6,0" FontSize="10"/>
                                <Border Grid.Column="1" Style="{DynamicResource PluginSegmentedSelectorStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Flight ID 別" IsChecked="{Binding IsFlightIdMode}" Style="{DynamicResource PluginSegmentedOptionStyle}" GroupName="HfdlHistoryMode"/>
                                        <RadioButton Content="種別別" IsChecked="{Binding IsKindMode}" Style="{DynamicResource PluginSegmentedOptionStyle}" GroupName="HfdlHistoryMode"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Grid.Column="3" Text="検索" Style="{DynamicResource PluginListSearchLabelStyle}"/>
                                <TextBox Grid.Column="4" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource PluginListSearchTextBoxStyle}"/>
                                <TextBlock Grid.Column="5" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Run Text="{Binding FilteredCount, Mode=OneWay, StringFormat=N0}"/><Run Text=" 件"/>
                                </TextBlock>
                            </Grid>

                            <Border Grid.Row="1" Style="{DynamicResource PluginTimelineBorderStyle}">
                            <Grid>
                                <!-- 1) Flight ID 別 -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFlightIdMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <DataGrid x:Name="HfdlFlightIdDataGrid" ItemsSource="{Binding FilteredFlightIdGroups}"
                                              SelectedItem="{Binding SelectedListGroup, Mode=TwoWay}"
                                              Style="{DynamicResource PluginTimelineDataGridStyle}">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="最終受信" Width="82" SortMemberPath="LastReceivedAt" SortDirection="Descending"
                                                                    CellStyle="{DynamicResource PluginTimelineTimestampCellStyle}">
                                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                    <TextBlock Style="{DynamicResource PluginTimelineTimestampTextStyle}" LineHeight="13" VerticalAlignment="Top" Margin="0,2,0,0">
                                                        <Run Text="{Binding LastReceivedAt, Mode=OneWay, StringFormat={}{0:yyyy/MM/dd}}"/><LineBreak/>
                                                        <Run Text="{Binding LastReceivedAt, Mode=OneWay, StringFormat={}{0:HH:mm:ss}}"/>
                                                    </TextBlock>
                                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Flight ID" Width="*" MinWidth="200" SortMemberPath="Key">
                                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                    <Grid Margin="0,2,0,3" TextElement.FontFamily="{DynamicResource DisplayFontFamily}">
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Key}" Style="{DynamicResource PluginTimelineIdentityTextStyle}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                                                        </Grid>
                                                        <TextBlock Grid.Row="1" Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0">
                                                            <Run Text="受信 "/><Run Text="{Binding Count, Mode=OneWay, StringFormat=N0}"/><Run Text=" 件"/>
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="Flight ID別の受信履歴はありません">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PluginEmptyStateTextStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=HfdlFlightIdDataGrid}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- 3) 種別別 -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsKindMode}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <DataGrid x:Name="HfdlKindDataGrid" ItemsSource="{Binding FilteredKindGroups}"
                                              SelectedItem="{Binding SelectedListGroup, Mode=TwoWay}"
                                              Style="{DynamicResource PluginTimelineDataGridStyle}">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="最終受信" Width="82" SortMemberPath="LastReceivedAt" SortDirection="Descending"
                                                                    CellStyle="{DynamicResource PluginTimelineTimestampCellStyle}">
                                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                    <TextBlock Style="{DynamicResource PluginTimelineTimestampTextStyle}" LineHeight="13" VerticalAlignment="Top" Margin="0,2,0,0">
                                                        <Run Text="{Binding LastReceivedAt, Mode=OneWay, StringFormat={}{0:yyyy/MM/dd}}"/><LineBreak/>
                                                        <Run Text="{Binding LastReceivedAt, Mode=OneWay, StringFormat={}{0:HH:mm:ss}}"/>
                                                    </TextBlock>
                                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="種別" Width="*" MinWidth="200" SortMemberPath="Key">
                                                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                    <Grid Margin="0,2,0,3" TextElement.FontFamily="{DynamicResource DisplayFontFamily}">
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Key}" Style="{DynamicResource PluginTimelineIdentityTextStyle}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0">
                                                                <Run Text="Flight ID "/><Run Text="{Binding FlightId, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </Grid>
                                                        <TextBlock Grid.Row="1" Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0">
                                                            <Run Text="受信 "/><Run Text="{Binding Count, Mode=OneWay, StringFormat=N0}"/><Run Text=" 件"/>
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="種別別の受信履歴はありません">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PluginEmptyStateTextStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=HfdlKindDataGrid}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                            </Border>

                            <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                                          Background="Transparent" ResizeDirection="Rows"/>

                            <controls:SelectionDetailPane Grid.Row="3" DetailContent="{Binding SelectedListGroup}"
                                EmptyText="一覧から Flight ID または種別を選択すると、最新ペイロードが表示されます">
                                <controls:SelectionDetailPane.DetailContentTemplate>
                                    <DataTemplate>
                                    <Grid Margin="4,2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="3*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.ColumnSpan="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Key}"
                                                       Style="{DynamicResource PluginSelectionDetailHeaderStyle}"/>
                                            <TextBlock Grid.Column="1" Foreground="{DynamicResource TextDimBrush}">
                                                <Run Text="{Binding Count, Mode=OneWay, StringFormat={}{0:N0} 件}"/>
                                                <Run Text="  最終受信 "/>
                                                <Run Text="{Binding LastReceivedAt, Mode=OneWay, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}"/>
                                            </TextBlock>
                                        </Grid>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,4,8,0">
                                            <UniformGrid Columns="2" Margin="0,0,0,5">
                                                <TextBlock>
                                                    <Run Text="Flight ID: " Foreground="{DynamicResource TextDimBrush}"/>
                                                    <Run Text="{Binding FlightId, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                         FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                </TextBlock>
                                                <TextBlock>
                                                    <Run Text="種別: " Foreground="{DynamicResource TextDimBrush}"/>
                                                    <Run Text="{Binding Kind, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                         FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                </TextBlock>
                                            </UniformGrid>
                                        </StackPanel>
                                        <Border Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="1,0,0,0" Padding="8,0,0,0" Margin="8,4,0,0">
                                            <StackPanel>
                                                <TextBlock Text="受信履歴" Style="{DynamicResource PluginSecondarySectionHeaderStyle}" Margin="0,0,0,4"/>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsControl ItemsSource="{Binding History}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="58"/>
                                                                        <ColumnDefinition Width="78"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding ReceivedAt, StringFormat=HH:mm:ss}" Foreground="{DynamicResource TextDimBrush}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                                    <TextBlock Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                                                        <Run Text="{Binding FlightId, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Kind, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                    <TextBlock Grid.Column="2" Text="{Binding PayloadHex}" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PayloadHex}"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    </DataTemplate>
                                </controls:SelectionDetailPane.DetailContentTemplate>
                            </controls:SelectionDetailPane>
                        </Grid>
                    </TabItem>

                    <!-- 3. 時系列 -->
                    <TabItem Header="時系列">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="160" MinHeight="96" MaxHeight="260"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="8,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="受信イベントを新しい順に表示します"
                                           Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="検索" Style="{DynamicResource PluginListSearchLabelStyle}"/>
                                <TextBox Grid.Column="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{DynamicResource PluginListSearchTextBoxStyle}"/>
                                <TextBlock Grid.Column="3" Foreground="{DynamicResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Run Text="{Binding FilteredMessages.Count, Mode=OneWay, StringFormat=N0}"/><Run Text=" 件"/>
                                </TextBlock>
                            </Grid>
                            <Border Grid.Row="1" Style="{DynamicResource PluginTimelineBorderStyle}">
                            <Grid>
                                <DataGrid x:Name="HfdlTimelineDataGrid" ItemsSource="{Binding FilteredMessages}"
                                          SelectedItem="{Binding SelectedTimelineReception, Mode=TwoWay}"
                                          Style="{DynamicResource PluginTimelineDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="日時" Width="82" SortMemberPath="ReceivedAt"
                                                                CellStyle="{DynamicResource PluginTimelineTimestampCellStyle}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Style="{DynamicResource PluginTimelineTimestampTextStyle}" LineHeight="13" VerticalAlignment="Top" Margin="0,2,0,0">
                                                        <Run Text="{Binding ReceivedAt, Mode=OneWay, StringFormat={}{0:yyyy/MM/dd}}"/><LineBreak/>
                                                        <Run Text="{Binding ReceivedAt, Mode=OneWay, StringFormat={}{0:HH:mm:ss}}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="受信イベント" Width="*" MinWidth="200" SortMemberPath="FlightId">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2,0,3" TextElement.FontFamily="{DynamicResource DisplayFontFamily}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding FlightId}" Style="{DynamicResource PluginTimelineIdentityTextStyle}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                                                        </Grid>
                                                        <TextBlock Grid.Row="1" Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0" TextWrapping="Wrap">
                                                            <Run Text="{Binding SourceAddress, Mode=OneWay}"/><Run Text=" → "/><Run Text="{Binding DestinationAddress, Mode=OneWay}"/>
                                                            <Run Text="  /  "/><Run Text="{Binding Modulation, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock Grid.Row="2" Text="{Binding PayloadHex}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        <TextBlock Grid.Row="3" Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0" TextWrapping="Wrap">
                                                            <Run Text="{Binding FrequencyHz, Mode=OneWay, StringFormat={}{0:N0} Hz}"/><Run Text="  /  Quality "/><Run Text="{Binding SignalQuality, Mode=OneWay, StringFormat={}{0:F1}}"/>
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="該当する受信イベントはありません">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource PluginEmptyStateTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=HfdlTimelineDataGrid}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                             </Grid>
                             </Border>
                            <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"/>
                            <controls:TimelineDetailPane Grid.Row="3" DetailContent="{Binding SelectedTimelineReception}"
                                EmptyText="時系列の受信イベントを選択すると、HFDL フレームの詳細が表示されます">
                                <controls:TimelineDetailPane.DetailContentTemplate><DataTemplate><StackPanel Margin="4,2">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding FlightId}" Style="{DynamicResource PluginSelectionDetailHeaderStyle}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ReceivedAt, StringFormat={}{0:yyyy/MM/dd HH:mm:ss.fff zzz}}" Style="{DynamicResource PluginTimelineDetailLabelStyle}"/>
                                    </Grid>
                                    <UniformGrid Columns="4" Margin="0,4,0,2">
                                        <StackPanel><TextBlock Text="種別 / Type" Style="{DynamicResource PluginTimelineDetailLabelStyle}"/><TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}"><Run Text="{Binding Kind, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Type, Mode=OneWay}"/></TextBlock></StackPanel>
                                        <StackPanel><TextBlock Text="変調 / CRC" Style="{DynamicResource PluginTimelineDetailLabelStyle}"/><TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}"><Run Text="{Binding Modulation, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding IsCrcValid, Mode=OneWay}"/></TextBlock></StackPanel>
                                        <StackPanel><TextBlock Text="周波数" Style="{DynamicResource PluginTimelineDetailLabelStyle}"/><TextBlock Text="{Binding FrequencyHz, StringFormat={}{0:N0} Hz}" Style="{DynamicResource PluginTimelineDetailValueStyle}"/></StackPanel>
                                        <StackPanel><TextBlock Text="品質" Style="{DynamicResource PluginTimelineDetailLabelStyle}"/><TextBlock Text="{Binding SignalQuality, StringFormat={}{0:F1}}" Style="{DynamicResource PluginTimelineDetailValueStyle}"/></StackPanel>
                                    </UniformGrid>
                                    <TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}" Margin="0,4,0,0"><Run Text="{Binding SourceAddress, Mode=OneWay}"/><Run Text=" → "/><Run Text="{Binding DestinationAddress, Mode=OneWay}"/><Run Text="  /  "/><Run Text="{Binding ChannelId, Mode=OneWay}"/><Run Text="  /  "/><Run Text="{Binding GroundStationId, Mode=OneWay}"/></TextBlock>
                                    <Expander Header="ペイロード / Raw frame" Style="{DynamicResource PluginTimelineExpanderStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding PayloadHex}" Style="{DynamicResource PluginTimelineDetailValueStyle}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding RawFrameHex}" Style="{DynamicResource PluginTimelineDetailValueStyle}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel></DataTemplate></controls:TimelineDetailPane.DetailContentTemplate>
                            </controls:TimelineDetailPane>
                        </Grid>
                    </TabItem>

                    <!-- 4. 地図 -->
                    <TabItem Header="地図">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Margin="8,6" Padding="4">
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}" FontSize="10">
                                    <Run Text="表示対象: 選択中地上局（受信機体位置ではありません）　|　局名: "/><Run Text="{Binding SelectedGroundStation.Name, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/><Run Text="　|　選択周波数: "/><Run Text="{Binding SelectedChannel.FrequencyDisplay, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </TextBlock>
                            </Border>
                            <Border Grid.Row="1" Margin="4" Background="{DynamicResource PanelBaseBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="2" ClipToBounds="True">
                                <Grid>
                                    <wpf:GeoMapView MapId="hfdl" LabelToggleText="コールサイン" ItemsSource="{Binding MapMarkers}"/>
                                    <TextBlock Text="地上局を選択してください">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PluginEmptyStateTextStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MapMarkers.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- 4. 診断 -->
                    <TabItem Header="診断">
                        <DockPanel Margin="12,10" LastChildFill="True">
                            <controls:DiagnosticsOverview DockPanel.Dock="Top"
                                StatusKind="{Binding OverallStatusKind}"
                                StatusText="{Binding OverallStatus}"
                                PhaseText="{Binding OverallPhase, StringFormat=段階: {0}}"
                                LastUpdatedText="{Binding OverallLastUpdated, StringFormat=更新 {0}}"
                                SummaryText="{Binding OverallSummary}"
                                RecommendationText="{Binding OverallRecommendation}"
                                RuntimeDiagnostics="{Binding RuntimeDiagnostics}"
                                ChannelText="{Binding SelectedFrequencyText}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel MaxWidth="760" HorizontalAlignment="Stretch">
                                <Expander Header="リアルタイム処理" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                    <controls:RuntimeDiagnosticsDetails RuntimeDiagnostics="{Binding RuntimeDiagnostics}" />
                                </Expander>

                                <!-- 2. 入力・選局 -->
                                <Expander Header="入力・選局" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                <Border Style="{DynamicResource PluginMetricCardStyle}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="入力・選局" Style="{DynamicResource PluginTertiarySectionHeaderStyle}" Margin="0,0,0,9"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                                            <TextBlock Text="地上局・周波数" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SelectedFrequencyText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="1" Text="信号中心オフセット" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ChannelOffsetText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Text="対象帯域" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PassbandStatusText}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="3" Text="レート変換" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RateConversionSummaryText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="4" Text="IQ入力 → 中間 → 復調レート" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding IntermediateRateText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                </Expander>

                                <!-- 3. 信号・チャネル -->
                                <Expander Header="信号・チャネル" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                <Border Style="{DynamicResource PluginMetricCardStyle}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="信号・チャネル" Style="{DynamicResource PluginTertiarySectionHeaderStyle}" Margin="0,0,0,9"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                                            <TextBlock Text="IQ入力レベル" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding InputLevelText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Text="チャネル RMS" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ChannelLevelText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Text="チャネルピーク" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ChannelPeakText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                </Expander>

                                <!-- 4. 復調・同期 -->
                                <Expander Header="検出・同期・復調" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                <Border Style="{DynamicResource PluginMetricCardStyle}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="復調・同期" Style="{DynamicResource PluginTertiarySectionHeaderStyle}" Margin="0,0,0,9"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                                            <TextBlock Text="プリアンブル一致度" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SearchCorrelationText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Text="同期・データ品質" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SynchronizationQualityText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Text="搬送波オフセット" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CarrierOffsetText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="3" Text="データレート・変調" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ModeText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="4" Text="探索・候補・同期" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RecentSearchCountsText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                </Expander>

                                <!-- 5. 検証・復号 -->
                                <Expander Header="検証・復号" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                <Border Style="{DynamicResource PluginMetricCardStyle}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="検証・復号" Style="{DynamicResource PluginTertiarySectionHeaderStyle}" Margin="0,0,0,9"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                                            <TextBlock Text="直近の検証結果" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding RecentValidationText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="1" Text="CRC/FEC検証済み" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ValidFrames, StringFormat=N0}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Text="CRC/FEC不一致" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RejectedFrames, StringFormat=N0}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="3" Text="検証合格率（累積）" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"><Run Text="{Binding AcceptanceRate, Mode=OneWay, StringFormat=F1}"/><Run Text=" %"/></TextBlock>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                </Expander>

                                <Expander Header="詳細・デバッグ" Style="{DynamicResource PluginDiagnosticsSectionStyle}" IsExpanded="False">
                                    <StackPanel Margin="8,5">
                                        <TextBlock Text="{Binding RateConversionText}" Foreground="{DynamicResource TextDimBrush}" FontFamily="{DynamicResource DisplayFontFamily}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SearchCountsText}" Foreground="{DynamicResource TextDimBrush}" FontFamily="{DynamicResource DisplayFontFamily}" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding BufferText}" Foreground="{DynamicResource TextDimBrush}" FontFamily="{DynamicResource DisplayFontFamily}" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding ProcessedText}" Foreground="{DynamicResource TextDimBrush}" FontFamily="{DynamicResource DisplayFontFamily}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Expander>

                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
