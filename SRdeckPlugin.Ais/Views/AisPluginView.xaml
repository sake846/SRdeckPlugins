<UserControl x:Class="SRdeckPlugin.Ais.Views.AisPluginView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:views="clr-namespace:SRdeckPlugin.Ais.Views"
              xmlns:ais="clr-namespace:SRdeckPlugin.Ais"
              xmlns:wpf="clr-namespace:SRdeckPlugin.Wpf;assembly=SRdeckPlugin.Wpf"
              xmlns:controls="clr-namespace:SRdeckPlugin.Wpf.Controls;assembly=SRdeckPlugin.Wpf">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <views:AisSettingsView/>

        <Border Grid.Row="1" Style="{DynamicResource PluginFlatOuterPanelStyle}" Margin="6,0,6,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{DynamicResource PluginStatusHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Style="{DynamicResource PluginStatusIndicatorStyle}" Tag="{Binding OverallStatusKind}"/>
                            <TextBlock Text="受信状態" Style="{DynamicResource PluginStatusHeaderTitleStyle}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="8,0" ToolTip="{Binding Status}">
                            <TextBlock.Text><MultiBinding StringFormat="{}{0} / {1}"><Binding Path="OverallStatus"/><Binding Path="Status"/></MultiBinding></TextBlock.Text>
                        </TextBlock>
                        <Button Grid.Column="2" Content="クリア" Command="{Binding ClearCommand}" Width="60" Height="26" FontSize="10"/>
                    </Grid>
                </Border>

                <TabControl Grid.Row="1" Style="{DynamicResource PluginTabControlStyle}" Padding="0"
                            Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10">
                    <TabItem Header="概要">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="8">
                                <controls:ReceptionOverviewPanel DataContext="{Binding Overview}"/>
                                <TextBlock Text="詳しく確認" Style="{DynamicResource PluginPrimarySectionHeaderStyle}" Margin="2,12,0,5"/>
                                <TextBlock Text="{Binding Overview.DetailHint}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="2,0,2,6"/>
                                <UniformGrid Columns="4">
                                    <Button Content="一覧を開く" Tag="{Binding ElementName=OverviewListTab}" Click="OpenOverviewTab" Margin="2" Height="22"/>
                                    <Button Content="時系列を開く" Tag="{Binding ElementName=OverviewTimelineTab}" Click="OpenOverviewTab" Margin="2" Height="22"/>
                                    <Button Content="地図を開く" Tag="{Binding ElementName=OverviewMapTab}" Click="OpenOverviewTab" Margin="2" Height="22"/>
                                    <Button Content="診断を開く" Tag="{Binding ElementName=OverviewDiagnosticsTab}" Click="OpenOverviewTab" Margin="2" Height="22"/>
                                </UniformGrid>
                                <TextBlock Text="受信できない場合や品質の理由を調べる場合は、診断で確認できます。" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap" Margin="2,4,2,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem x:Name="OverviewListTab" Header="一覧">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition Height="170" MinHeight="96" MaxHeight="260"/></Grid.RowDefinitions>
                            <Grid Margin="8,6,8,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="船舶・局別" Foreground="{DynamicResource PluginDisplayAccentPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="検索" Style="{DynamicResource PluginListSearchLabelStyle}"/>
                                <TextBox Grid.Column="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource PluginListSearchTextBoxStyle}"/>
                                <TextBlock Grid.Column="3" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Run Text="{Binding FilteredTargets.Count, Mode=OneWay, StringFormat=N0}"/><Run Text=" 件"/>
                                </TextBlock>
                            </Grid>
                            <Border Grid.Row="1" Style="{DynamicResource PluginTimelineBorderStyle}">
                            <Grid>
                                <DataGrid x:Name="AisTargetsGrid" ItemsSource="{Binding FilteredTargets}" SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                                          Style="{DynamicResource PluginTimelineDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="最終受信" Width="82" SortMemberPath="LastSeen" SortDirection="Descending"
                                                                CellStyle="{DynamicResource PluginTimelineTimestampCellStyle}">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <StackPanel Margin="0">
                                                    <TextBlock Style="{DynamicResource PluginTimelineTimestampTextStyle}" LineHeight="13">
                                                        <Run Text="{Binding LastSeen, Mode=OneWay, StringFormat={}{0:yyyy/MM/dd}}"/><LineBreak/>
                                                        <Run Text="{Binding LastSeen, Mode=OneWay, StringFormat={}{0:HH:mm:ss}}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding ActivityStatusText, Mode=OneWay}"
                                                               Foreground="{DynamicResource TextDimBrush}"
                                                               FontSize="10" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="船舶・局" Width="*" MinWidth="200" SortMemberPath="DisplayName">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <Grid Margin="0,2,0,2" TextElement.FontFamily="{DynamicResource DisplayFontFamily}">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <!-- 1行目: 船名・局名 ＋ MMSI/コールサイン (左) ＋ 受信件数 (右) -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock DockPanel.Dock="Left" Text="{Binding DisplayName}" Style="{DynamicResource PluginTimelineIdentityTextStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                            <TextBlock DockPanel.Dock="Left" Margin="8,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                                <Run Text="MMSI "/><Run Text="{Binding MmsiText, Mode=OneWay}"/>
                                                                <Run Text=" "/><Run Text="{Binding CallSign, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </DockPanel>
                                                        <TextBlock Grid.Column="1" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="8,0,0,0">
                                                            <Run Text="受信 "/><Run Text="{Binding Messages, Mode=OneWay, StringFormat=N0}"/><Run Text=" 件"/>
                                                        </TextBlock>
                                                    </Grid>
                                                    <!-- 2行目: 最新メッセージ要約 ── 最新チャネル -->
                                                    <Grid Grid.Row="1" Margin="0,3,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding LatestSummary, Mode=OneWay}"
                                                                   Foreground="{DynamicResource TextDimBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"
                                                                   ToolTip="{Binding LatestSummary, Mode=OneWay}"/>
                                                        <TextBlock Grid.Column="1" Margin="8,0,0,0"
                                                                   Text="{Binding Channel, Mode=OneWay}"
                                                                   Foreground="{DynamicResource PluginDisplayAccentSecondaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <!-- 3行目: 航海状態・船種バッジ ── 滞在時間 -->
                                                    <Grid Grid.Row="2" Margin="0,3,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <!-- 航海状態バッジ -->
                                                            <Border Background="{DynamicResource InstrumentBaseBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding NavigationStatusText}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding NavigationStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                            </Border>
                                                            <!-- 船種バッジ -->
                                                            <Border Background="{DynamicResource InstrumentBaseBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ShipTypeText}" Value="">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding ShipTypeText}" Foreground="{DynamicResource TextDimBrush}" FontSize="9" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                            </Border>
                                                        </WrapPanel>
                                                        <TextBlock Grid.Column="1" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="8,0,0,0">
                                                            <Run Text="滞在 "/><Run Text="{Binding DurationText, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="該当する船舶・局はありません"
                                           Foreground="{DynamicResource TextDimBrush}"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="16">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=AisTargetsGrid}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            </Border>
                            <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                                          Background="Transparent" ResizeDirection="Rows"/>
                            <controls:SelectionDetailPane Grid.Row="3" DetailContent="{Binding SelectedTarget}"
                                EmptyText="一覧から船舶または局を選択すると、識別・航海・動静情報が表示されます">
                                <controls:SelectionDetailPane.DetailContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6,4">
                                            <!-- 1. タイトル行 -->
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DisplayName}" Style="{DynamicResource PluginIdentityTextStyle}" Margin="0,0,8,0" TextWrapping="Wrap"/>
                                                <Border Grid.Column="1" Background="{DynamicResource OverlayBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ActivityStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                                </Border>
                                            </Grid>

                                            <!-- 2. 識別・受信条件・航海情報 -->
                                            <WrapPanel Margin="0,0,0,6">
                                                <TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}" Margin="0,1,12,3" TextWrapping="Wrap">
                                                    <Run Text="MMSI " Foreground="{DynamicResource PluginDisplayAccentSecondaryBrush}"/><Run Text="{Binding MmsiText, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}" Margin="0,1,12,3" TextWrapping="Wrap">
                                                    <Run Text="コールサイン " Foreground="{DynamicResource PluginDisplayAccentSecondaryBrush}"/><Run Text="{Binding CallSign, Mode=OneWay, TargetNullValue=—}"/>
                                                </TextBlock>
                                                <TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}" Margin="0,1,12,3" TextWrapping="Wrap">
                                                    <Run Text="最新チャネル " Foreground="{DynamicResource PluginDisplayAccentSecondaryBrush}"/><Run Text="{Binding Channel, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}" Margin="0,1,12,3" TextWrapping="Wrap">
                                                    <Run Text="初回 " Foreground="{DynamicResource PluginDisplayAccentSecondaryBrush}"/><Run Text="{Binding FirstSeen, Mode=OneWay, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}"/>
                                                </TextBlock>
                                                <TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}" Margin="0,1,12,3" TextWrapping="Wrap">
                                                    <Run Text="最終 " Foreground="{DynamicResource PluginDisplayAccentSecondaryBrush}"/><Run Text="{Binding LastSeen, Mode=OneWay, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}"/>
                                                </TextBlock>
                                                <TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}" Margin="0,1,12,3" TextWrapping="Wrap">
                                                    <Run Text="船種 " Foreground="{DynamicResource PluginDisplayAccentSecondaryBrush}"/><Run Text="{Binding ShipTypeText, Mode=OneWay, TargetNullValue=—}"/>
                                                </TextBlock>
                                                <TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}" Margin="0,1,12,3" TextWrapping="Wrap">
                                                    <Run Text="航海状態 " Foreground="{DynamicResource PluginDisplayAccentSecondaryBrush}"/><Run Text="{Binding NavigationStatusText, Mode=OneWay, TargetNullValue=—}"/>
                                                </TextBlock>
                                                <TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}" Margin="0,1,12,3" TextWrapping="Wrap">
                                                    <Run Text="目的地 " Foreground="{DynamicResource PluginDisplayAccentSecondaryBrush}"/><Run Text="{Binding Destination, Mode=OneWay, TargetNullValue=—}"/>
                                                </TextBlock>
                                                <TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}" Margin="0,1,12,3" TextWrapping="Wrap">
                                                    <Run Text="位置 " Foreground="{DynamicResource PluginDisplayAccentSecondaryBrush}"/><Run Text="{Binding LatitudeDisplay, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding LongitudeDisplay, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}" Margin="0,1,12,3" TextWrapping="Wrap">
                                                    <Run Text="対地速度 " Foreground="{DynamicResource PluginDisplayAccentSecondaryBrush}"/><Run Text="{Binding SpeedKnots, Mode=OneWay, StringFormat={}{0:F1} kt, TargetNullValue=—}"/>
                                                </TextBlock>
                                                <TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}" Margin="0,1,12,3" TextWrapping="Wrap">
                                                    <Run Text="対地針路 " Foreground="{DynamicResource PluginDisplayAccentSecondaryBrush}"/><Run Text="{Binding CourseDegrees, Mode=OneWay, StringFormat={}{0:F1}°, TargetNullValue=—}"/>
                                                </TextBlock>
                                                <TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}" Margin="0,1,12,3" TextWrapping="Wrap">
                                                    <Run Text="真方位 " Foreground="{DynamicResource PluginDisplayAccentSecondaryBrush}"/><Run Text="{Binding HeadingDegrees, Mode=OneWay, StringFormat={}{0}°, TargetNullValue=—}"/>
                                                </TextBlock>
                                                <TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}" Margin="0,1,12,3" TextWrapping="Wrap">
                                                    <Run Text="受信統計 " Foreground="{DynamicResource PluginDisplayAccentSecondaryBrush}"/><Run Text="{Binding Messages, Mode=OneWay, StringFormat={}{0:N0} 件}"/><Run Text=" (滞在 "/><Run Text="{Binding DurationText, Mode=OneWay}"/><Run Text=")"/>
                                                </TextBlock>
                                            </WrapPanel>

                                            <!-- 3. 最新メッセージ / 動静 -->
                                            <TextBlock Text="最新メッセージ" Style="{DynamicResource PluginPrimarySectionHeaderStyle}" Margin="0,4,0,3"/>
                                            <TextBlock Text="{Binding LatestSummary, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </controls:SelectionDetailPane.DetailContentTemplate>
                            </controls:SelectionDetailPane>
                        </Grid>
                    </TabItem>

                    <TabItem x:Name="OverviewTimelineTab" Header="時系列">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition Height="160" MinHeight="96" MaxHeight="260"/></Grid.RowDefinitions>
                            <Grid Margin="8,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="時系列順" Foreground="{DynamicResource PluginDisplayAccentPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="検索" Style="{DynamicResource PluginListSearchLabelStyle}"/>
                                <TextBox Grid.Column="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource PluginListSearchTextBoxStyle}"/>
                                <TextBlock Grid.Column="3" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Run Text="{Binding FilteredMessages.Count, Mode=OneWay, StringFormat=N0}"/><Run Text=" 件"/>
                                </TextBlock>
                            </Grid>
                            <Border Grid.Row="1" Style="{DynamicResource PluginTimelineBorderStyle}">
                            <Grid>
                                <DataGrid x:Name="AisTimelineGrid" ItemsSource="{Binding FilteredMessages}"
                                          SelectedItem="{Binding SelectedTimelineMessage, Mode=TwoWay}"
                                          Style="{DynamicResource PluginTimelineDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="日時" Width="82" SortMemberPath="ReceivedAt"
                                                                CellStyle="{DynamicResource PluginTimelineTimestampCellStyle}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Style="{DynamicResource PluginTimelineTimestampTextStyle}" LineHeight="13" VerticalAlignment="Top" Margin="0">
                                                        <Run Text="{Binding ReceivedAt, Mode=OneWay, StringFormat={}{0:yyyy/MM/dd}}"/><LineBreak/>
                                                        <Run Text="{Binding ReceivedAt, Mode=OneWay, StringFormat={}{0:HH:mm:ss}}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="受信イベント" Width="*" MinWidth="200" SortMemberPath="Name">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2,0,2" TextElement.FontFamily="{DynamicResource DisplayFontFamily}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <!-- 1行目: 船名・局名 ＋ MMSI ── メッセージ種別 -->
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Style="{DynamicResource PluginTimelineIdentityTextStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                <TextBlock DockPanel.Dock="Left" Margin="8,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                                    <Run Text="MMSI "/><Run Text="{Binding MmsiText, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </DockPanel>
                                                            <Border Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                                                                    Background="{DynamicResource OverlayBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="5,1">
                                                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11">
                                                                    <Run Text="# "/><Run Text="{Binding MessageType, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </Border>
                                                        </Grid>
                                                        <!-- 2行目: メッセージ要約 ── 受信チャネル -->
                                                        <Grid Grid.Row="1" Margin="0,3,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Summary, Mode=OneWay}"
                                                                       Foreground="{DynamicResource TextDimBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"
                                                                       ToolTip="{Binding Summary, Mode=OneWay}"/>
                                                            <TextBlock Grid.Column="1" Margin="8,0,0,0"
                                                                       Text="{Binding Channel, Mode=OneWay}"
                                                                       Foreground="{DynamicResource PluginDisplayAccentSecondaryBrush}"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="該当する受信イベントはありません"
                                           Foreground="{DynamicResource TextDimBrush}"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="16">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=AisTimelineGrid}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                             </Grid>
                             </Border>
                            <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"/>
                            <controls:SelectionDetailPane Grid.Row="3" DetailContent="{Binding SelectedTimelineMessage}"
                                EmptyText="時系列の受信イベントを選択すると、AIS メッセージの詳細が表示されます">
                                <controls:SelectionDetailPane.DetailContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6,4">
                                            <!-- 1. タイトル行 -->
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Style="{DynamicResource PluginIdentityTextStyle}" Margin="0,0,8,0" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ReceivedAt, StringFormat={}{0:yyyy/MM/dd HH:mm:ss.fff zzz}}" Style="{DynamicResource PluginTimelineDetailTimestampStyle}"/>
                                            </Grid>

                                            <!-- 2. 識別・受信条件・航海情報 -->
                                            <WrapPanel Margin="0,0,0,6">
                                                <TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}" Margin="0,1,12,3" TextWrapping="Wrap">
                                                    <Run Text="MMSI " Foreground="{DynamicResource PluginDisplayAccentSecondaryBrush}"/><Run Text="{Binding MmsiText, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}" Margin="0,1,12,3" TextWrapping="Wrap">
                                                    <Run Text="種別 " Foreground="{DynamicResource PluginDisplayAccentSecondaryBrush}"/><Run Text="# "/><Run Text="{Binding MessageType, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Kind, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}" Margin="0,1,12,3" TextWrapping="Wrap">
                                                    <Run Text="チャネル " Foreground="{DynamicResource PluginDisplayAccentSecondaryBrush}"/><Run Text="{Binding Channel, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}" Margin="0,1,12,3" TextWrapping="Wrap">
                                                    <Run Text="位置 " Foreground="{DynamicResource PluginDisplayAccentSecondaryBrush}"/><Run Text="{Binding LatitudeDisplay, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding LongitudeDisplay, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}" Margin="0,1,12,3" TextWrapping="Wrap">
                                                    <Run Text="対地速度 " Foreground="{DynamicResource PluginDisplayAccentSecondaryBrush}"/><Run Text="{Binding SpeedKnots, Mode=OneWay, StringFormat={}{0:F1} kt, TargetNullValue=—}"/>
                                                </TextBlock>
                                                <TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}" Margin="0,1,12,3" TextWrapping="Wrap">
                                                    <Run Text="対地針路 " Foreground="{DynamicResource PluginDisplayAccentSecondaryBrush}"/><Run Text="{Binding CourseDegrees, Mode=OneWay, StringFormat={}{0:F1}°, TargetNullValue=—}"/>
                                                </TextBlock>
                                            </WrapPanel>

                                            <!-- 3. メッセージ要約 -->
                                            <TextBlock Text="メッセージ要約" Style="{DynamicResource PluginPrimarySectionHeaderStyle}" Margin="0,4,0,3"/>
                                            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </controls:SelectionDetailPane.DetailContentTemplate>
                            </controls:SelectionDetailPane>
                        </Grid>
                    </TabItem>

                    <TabItem x:Name="OverviewMapTab" Header="地図">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Margin="8,6" Padding="4">
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}" FontSize="10">
                                    <Run Text="表示局数: "/><Run Text="{Binding PositionedTargetCount, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/><Run Text=" 局　|　位置出典: AIS無線メッセージ　|　地図保持: 直近"/><Run Text="{Binding RetentionMinutes, Mode=OneWay}"/><Run Text="分　|　航跡保持: 直近"/><Run Text="{Binding MaximumTrailPoints, Mode=OneWay, StringFormat={}{0:N0}}"/><Run Text="地点"/>
                                </TextBlock>
                            </Border>
                            <Border Grid.Row="1" Margin="4" Background="{DynamicResource PanelBaseBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="2" ClipToBounds="True">
                                <Grid>
                                    <wpf:GeoMapView MapId="ais" LegendHtml="{x:Static ais:AisMapPresentation.LegendHtml}" LabelToggleText="船名" ItemsSource="{Binding MapMarkers}"/>
                                    <TextBlock Text="位置情報を含むAISメッセージをまだ受信していません"
                                               Foreground="{DynamicResource TextDimBrush}"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="16">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding PositionedTargetCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem x:Name="OverviewDiagnosticsTab" Header="診断">
                        <DockPanel Margin="12,10" LastChildFill="True">
                            <controls:DiagnosticsOverview DockPanel.Dock="Top"
                                StatusKind="{Binding OverallStatusKind}"
                                StatusText="{Binding OverallStatus}"
                                PhaseText="{Binding OverallPhase, StringFormat=段階: {0}}"
                                LastUpdatedText="{Binding OverallLastUpdated, StringFormat=更新 {0}}"
                                SummaryText="{Binding OverallSummary}"
                                RecommendationText="{Binding OverallRecommendation}"
                                RuntimeDiagnostics="{Binding RuntimeDiagnostics}"
                                ChannelText="{Binding MonitoredChannelsText, StringFormat=監視 {0}}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel MaxWidth="760">
                                <Expander Header="リアルタイム処理" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                    <controls:RuntimeDiagnosticsDetails RuntimeDiagnostics="{Binding RuntimeDiagnostics}" />
                                </Expander>
                                <Expander Header="入力・選局" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                <Border Style="{DynamicResource PluginMetricCardStyle}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="入力・選局" Style="{DynamicResource PluginSecondarySectionHeaderStyle}" Margin="0,0,0,9"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                                            <TextBlock Text="監視チャネル" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding MonitoredChannelsText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Text="チャネルオフセット" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ChannelOffsetText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Text="対象帯域" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PassbandStatusText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="3" Text="レート変換" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RateConversionSummaryText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="4" Text="IQ入力 → 中間 → 復調レート" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding IntermediateRateText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                </Expander>
                                <Expander Header="信号・チャネル" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                    <StackPanel Margin="8,5">
                                        <TextBlock Text="{Binding ChannelADiagnosticText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ChannelBDiagnosticText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="検出・同期・復調" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                <Border Style="{DynamicResource PluginMetricCardStyle}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="検出・同期・復調" Style="{DynamicResource PluginSecondarySectionHeaderStyle}" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                                            <TextBlock Text="AIS 1 到達数" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Grid.Column="1" Text="{Binding ChannelADetectionText}" FontFamily="{DynamicResource DisplayFontFamily}" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="1" Text="AIS 2 到達数" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ChannelBDetectionText}" FontFamily="{DynamicResource DisplayFontFamily}" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="2" Text="coherent / fallback（累積）" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Grid.Row="2" Grid.Column="1" FontFamily="{DynamicResource DisplayFontFamily}"><Run Text="{Binding CoherentFrames, Mode=OneWay, StringFormat=N0}"/><Run Text=" / "/><Run Text="{Binding FallbackFrames, Mode=OneWay, StringFormat=N0}"/></TextBlock>
                                            <TextBlock Grid.Row="3" Text="周波数補正（最新）" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FrequencyCorrectionText}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                </Expander>
                                <Expander Header="検証・復号" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                    <StackPanel Margin="8,5">
                                        <TextBlock Text="{Binding RecentValidationText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" TextWrapping="Wrap"/>
                                        <TextBlock Foreground="{DynamicResource TextDimBrush}" FontFamily="{DynamicResource DisplayFontFamily}" Margin="0,4,0,0"><Run Text="累積（仮説単位）: FCS合格 "/><Run Text="{Binding HypothesisValidFrames, Mode=OneWay, StringFormat=N0}"/><Run Text=" / FCS不一致 "/><Run Text="{Binding HypothesisRejectedFrames, Mode=OneWay, StringFormat=N0}"/></TextBlock>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="詳細・デバッグ" Style="{DynamicResource PluginDiagnosticsSectionStyle}" IsExpanded="False">
                                    <StackPanel Margin="8,5">
                                        <TextBlock Text="GMSK 9600 bit/s / NRZI / HDLC / 複素整合相関 + coherent Viterbi MLSE" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding RateConversionText}" Foreground="{DynamicResource TextDimBrush}" FontFamily="{DynamicResource DisplayFontFamily}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
