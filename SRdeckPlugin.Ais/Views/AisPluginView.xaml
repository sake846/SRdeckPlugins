<UserControl x:Class="SRdeckPlugin.Ais.Views.AisPluginView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:views="clr-namespace:SRdeckPlugin.Ais.Views"
              xmlns:ais="clr-namespace:SRdeckPlugin.Ais"
              xmlns:wpf="clr-namespace:SRdeckPlugin.Wpf;assembly=SRdeckPlugin.Wpf"
              xmlns:controls="clr-namespace:SRdeckPlugin.Wpf.Controls;assembly=SRdeckPlugin.Wpf">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <views:AisSettingsView/>

        <Border Grid.Row="1" Style="{DynamicResource PluginFlatOuterPanelStyle}" Margin="6,0,6,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{DynamicResource PluginStatusHeaderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Style="{DynamicResource PluginStatusIndicatorStyle}" Tag="{Binding OverallStatusKind}"/>
                            <TextBlock Text="受信状態" Style="{DynamicResource PluginStatusHeaderTitleStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="クリア" Command="{Binding ClearCommand}" Width="60" Height="26" FontSize="10"/>
                    </Grid>
                </Border>

                <TabControl Grid.Row="1" Style="{DynamicResource PluginTabControlStyle}" Padding="0"
                            Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10">
                    <TabItem Header="概要">
                        <Grid Margin="10,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="受信の概況" Style="{DynamicResource PluginPrimarySectionHeaderStyle}" Margin="2,0,0,5"/>
                            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,8">
                                <Border Style="{DynamicResource PluginMetricCardStyle}">
                                    <StackPanel><TextBlock Text="受信中の船舶・局" Foreground="{DynamicResource TextDimBrush}"/>
                                    <TextBlock Text="{Binding Targets.Count}" Foreground="{DynamicResource PluginDisplayAccentPrimaryBrush}"
                                               FontFamily="{DynamicResource DisplayFontFamily}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                                </Border>
                                <Border Style="{DynamicResource PluginMetricCardStyle}">
                                    <StackPanel><TextBlock Text="位置取得局" Foreground="{DynamicResource TextDimBrush}"/>
                                    <TextBlock Text="{Binding PositionedTargetCount, StringFormat=N0}" Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontFamily="{DynamicResource DisplayFontFamily}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                                </Border>
                                <Border Style="{DynamicResource PluginMetricCardStyle}">
                                    <StackPanel><TextBlock Text="有効フレーム（累計）" Foreground="{DynamicResource TextDimBrush}"/>
                                    <TextBlock Text="{Binding ValidFrames, StringFormat=N0}" Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontFamily="{DynamicResource DisplayFontFamily}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                                </Border>
                                <Border Style="{DynamicResource PluginMetricCardStyle}">
                                    <StackPanel><TextBlock Text="正常率（累計）" Foreground="{DynamicResource TextDimBrush}"/>
                                    <TextBlock Text="{Binding AcceptanceRateText}" Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontFamily="{DynamicResource DisplayFontFamily}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                                </Border>
                            </UniformGrid>
                            <Border Grid.Row="2" Style="{DynamicResource PluginMetricCardStyle}" Padding="8,6">
                                <StackPanel>
                                    <TextBlock Text="受信成果" Style="{DynamicResource PluginSecondarySectionHeaderStyle}"/>
                                    <TextBlock Text="{Binding OverallSummary}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding OverallRecommendation}" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Grid.Row="3" Text="最近変化した船舶・局（最大3件）" Style="{DynamicResource PluginPrimarySectionHeaderStyle}" Margin="2,2,0,5"/>
                            <ListBox Grid.Row="4" ItemsSource="{Binding RecentTargets}" Style="{DynamicResource PluginCompactListStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,0,0,1" Padding="6,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/><ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="75"/><ColumnDefinition Width="75"/><ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding MmsiText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="{DynamicResource PluginDisplayAccentTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SpeedKnots, StringFormat={}{0:F1} kt}" Foreground="{DynamicResource TextDimBrush}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding CourseDegrees, StringFormat={}{0:F1}°}" Foreground="{DynamicResource TextDimBrush}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                <TextBlock Grid.Column="4" Text="{Binding LastSeen, StringFormat=HH:mm:ss}" Foreground="{DynamicResource TextDimBrush}"
                                                           FontFamily="{DynamicResource DisplayFontFamily}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="一覧">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition Height="170" MinHeight="96" MaxHeight="260"/></Grid.RowDefinitions>
                            <Grid Margin="8,6,8,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="把握している船舶・局の現在状態" Foreground="{DynamicResource PluginDisplayAccentPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="検索" Style="{DynamicResource PluginListSearchLabelStyle}"/>
                                <TextBox Grid.Column="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource PluginListSearchTextBoxStyle}"/>
                                <TextBlock Grid.Column="3" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Run Text="{Binding FilteredTargets.Count, Mode=OneWay, StringFormat=N0}"/><Run Text=" 件"/>
                                </TextBlock>
                            </Grid>
                            <Border Grid.Row="1" Style="{DynamicResource PluginTimelineBorderStyle}">
                            <Grid>
                                <DataGrid x:Name="AisTargetsGrid" ItemsSource="{Binding FilteredTargets}" SelectedItem="{Binding SelectedTarget}"
                                          Style="{DynamicResource PluginTimelineDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="最終受信" Width="82" SortMemberPath="LastSeen" SortDirection="Descending"
                                                                CellStyle="{DynamicResource PluginTimelineTimestampCellStyle}">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <TextBlock Style="{DynamicResource PluginTimelineTimestampTextStyle}" LineHeight="13" VerticalAlignment="Top" Margin="0,2,0,0">
                                                    <Run Text="{Binding LastSeen, Mode=OneWay, StringFormat={}{0:yyyy/MM/dd}}"/><LineBreak/>
                                                    <Run Text="{Binding LastSeen, Mode=OneWay, StringFormat={}{0:HH:mm:ss}}"/>
                                                </TextBlock>
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="船舶・局" Width="*" MinWidth="200" SortMemberPath="DisplayName">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                                <Grid Margin="0,2,0,3" TextElement.FontFamily="{DynamicResource DisplayFontFamily}">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding DisplayName}" Style="{DynamicResource PluginTimelineIdentityTextStyle}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0">
                                                            <Run Text="MMSI "/><Run Text="{Binding MmsiText, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </Grid>
                                                    <TextBlock Grid.Row="1" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap">
                                                        <Run Text="航海状態 "/><Run Text="{Binding NavigationStatusText, Mode=OneWay}"/>
                                                        <Run Text="  /  船種 "/><Run Text="{Binding ShipTypeText, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Row="2" Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0" TextWrapping="Wrap">
                                                        <Run Text="速度 "/><Run Text="{Binding SpeedKnots, Mode=OneWay, StringFormat={}{0:F1} kt, TargetNullValue=-}"/>
                                                        <Run Text="  /  針路 "/><Run Text="{Binding CourseDegrees, Mode=OneWay, StringFormat={}{0:F1}°, TargetNullValue=-}"/>
                                                        <Run Text="  /  受信 "/><Run Text="{Binding Messages, Mode=OneWay, StringFormat=N0}"/><Run Text=" 件"/>
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="まだ船舶またはAIS局を受信していません">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource PluginEmptyStateTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=AisTargetsGrid}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            </Border>
                            <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                                          Background="Transparent" ResizeDirection="Rows"/>
                            <controls:SelectionDetailPane Grid.Row="3" DetailContent="{Binding SelectedTarget}"
                                EmptyText="一覧から船舶または局を選択すると、識別・航海・位置情報が表示されます">
                                <controls:SelectionDetailPane.DetailContentTemplate>
                                    <DataTemplate>
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="識別" Style="{DynamicResource PluginSelectionDetailHeaderStyle}"/>
                                             <StackPanel><TextBlock Text="MMSI" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/><TextBlock Text="{Binding MmsiText, Mode=OneWay}" Style="{DynamicResource PluginTimelineDetailValueStyle}"/></StackPanel>
                                             <StackPanel><TextBlock Text="船名/局名" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/><TextBlock Text="{Binding DisplayName, Mode=OneWay}" Style="{DynamicResource PluginTimelineDetailValueStyle}" Foreground="{DynamicResource PluginDisplayAccentTertiaryBrush}"/></StackPanel>
                                             <StackPanel><TextBlock Text="コールサイン" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/><TextBlock Text="{Binding CallSign, Mode=OneWay}" Style="{DynamicResource PluginTimelineDetailValueStyle}" Foreground="{DynamicResource PluginDisplayAccentTertiaryBrush}"/></StackPanel>
                                             <StackPanel><TextBlock Text="最終受信" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/><TextBlock Text="{Binding LastSeen, Mode=OneWay, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}" Style="{DynamicResource PluginTimelineDetailValueStyle}"/></StackPanel>
                                            <TextBlock Text="航海情報" Style="{DynamicResource PluginSelectionDetailHeaderStyle}"/>
                                             <StackPanel><TextBlock Text="状態" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/><TextBlock Text="{Binding NavigationStatusText, Mode=OneWay}" Style="{DynamicResource PluginTimelineDetailValueStyle}"/></StackPanel>
                                              <StackPanel><TextBlock Text="目的地" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/><TextBlock Text="{Binding Destination, Mode=OneWay}" Style="{DynamicResource PluginTimelineDetailValueStyle}"/></StackPanel>
                                              <StackPanel><TextBlock Text="船種" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/><TextBlock Text="{Binding ShipTypeText, Mode=OneWay}" Style="{DynamicResource PluginTimelineDetailValueStyle}"/></StackPanel>
                                              <StackPanel><TextBlock Text="チャンネル" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/><TextBlock Text="{Binding Channel, Mode=OneWay}" Style="{DynamicResource PluginTimelineDetailValueStyle}"/></StackPanel>
                                            <TextBlock Text="位置・動静" Style="{DynamicResource PluginSelectionDetailHeaderStyle}" Margin="0,6,0,0"/>
                                             <StackPanel><TextBlock Text="緯度" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/><TextBlock Text="{Binding Latitude, Mode=OneWay, StringFormat=F5}" Style="{DynamicResource PluginTimelineDetailValueStyle}"/></StackPanel>
                                             <StackPanel><TextBlock Text="経度" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/><TextBlock Text="{Binding Longitude, Mode=OneWay, StringFormat=F5}" Style="{DynamicResource PluginTimelineDetailValueStyle}"/></StackPanel>
                                             <StackPanel><TextBlock Text="速度 / 針路" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/><TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}"><Run Text="{Binding SpeedKnots, Mode=OneWay, StringFormat=F1}"/><Run Text=" kt / "/><Run Text="{Binding CourseDegrees, Mode=OneWay, StringFormat=F1}"/><Run Text="°"/></TextBlock></StackPanel>
                                             <StackPanel><TextBlock Text="真方位 / 受信数" Style="{DynamicResource PluginSelectionDetailLabelStyle}"/><TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}"><Run Text="{Binding HeadingDegrees, Mode=OneWay}"/><Run Text="° / "/><Run Text="{Binding Messages, Mode=OneWay, StringFormat=N0}"/></TextBlock></StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="1" BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="1,0,0,0" Padding="8,0,0,0" Margin="8,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="受信履歴" Style="{DynamicResource PluginSecondarySectionHeaderStyle}" Margin="0,0,0,4"/>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsControl ItemsSource="{Binding History}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="58"/>
                                                                        <ColumnDefinition Width="72"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding ReceivedAt, StringFormat=HH:mm:ss}" Foreground="{DynamicResource TextDimBrush}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                                                    <TextBlock Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                                                        <Run Text="{Binding Channel, Mode=OneWay}"/><Run Text="  #"/><Run Text="{Binding MessageType, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                    <TextBlock Grid.Column="2" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}">
                                                                        <Run Text="{Binding Name, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Summary, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>
                                     </Grid>
                                    </DataTemplate>
                                </controls:SelectionDetailPane.DetailContentTemplate>
                            </controls:SelectionDetailPane>
                        </Grid>
                    </TabItem>

                    <TabItem Header="時系列">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="5"/><RowDefinition Height="160" MinHeight="96" MaxHeight="260"/></Grid.RowDefinitions>
                            <Grid Margin="8,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="時系列順" Foreground="{DynamicResource PluginDisplayAccentPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="検索" Style="{DynamicResource PluginListSearchLabelStyle}"/>
                                <TextBox Grid.Column="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource PluginListSearchTextBoxStyle}"/>
                                <TextBlock Grid.Column="3" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Run Text="{Binding FilteredMessages.Count, Mode=OneWay, StringFormat=N0}"/><Run Text=" 件"/>
                                </TextBlock>
                            </Grid>
                            <Border Grid.Row="1" Style="{DynamicResource PluginTimelineBorderStyle}">
                            <Grid>
                                <DataGrid x:Name="AisTimelineGrid" ItemsSource="{Binding FilteredMessages}"
                                          SelectedItem="{Binding SelectedTimelineMessage, Mode=TwoWay}"
                                          Style="{DynamicResource PluginTimelineDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="日時" Width="82" SortMemberPath="ReceivedAt"
                                                                CellStyle="{DynamicResource PluginTimelineTimestampCellStyle}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Style="{DynamicResource PluginTimelineTimestampTextStyle}" LineHeight="13" VerticalAlignment="Top" Margin="0,2,0,0">
                                                        <Run Text="{Binding ReceivedAt, Mode=OneWay, StringFormat={}{0:yyyy/MM/dd}}"/><LineBreak/>
                                                        <Run Text="{Binding ReceivedAt, Mode=OneWay, StringFormat={}{0:HH:mm:ss}}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="受信イベント" Width="*" MinWidth="200" SortMemberPath="Name">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2,0,3" TextElement.FontFamily="{DynamicResource DisplayFontFamily}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" Style="{DynamicResource PluginTimelineIdentityTextStyle}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                                                        </Grid>
                                                        <TextBlock Grid.Row="1" Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0" TextWrapping="Wrap">
                                                            <Run Text="MMSI "/><Run Text="{Binding Mmsi, Mode=OneWay, StringFormat={}{0:000000000}}"/>
                                                            <Run Text="  /  Type "/><Run Text="{Binding MessageType, Mode=OneWay}"/><Run Text="  /  CH "/><Run Text="{Binding Channel, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock Grid.Row="2" Text="{Binding Summary}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                        <TextBlock Grid.Row="3" Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0" TextWrapping="Wrap">
                                                            <Run Text="SOG "/><Run Text="{Binding SpeedKnots, Mode=OneWay, StringFormat={}{0:F1} kt, TargetNullValue=-}"/>
                                                            <Run Text="  /  COG "/><Run Text="{Binding CourseDegrees, Mode=OneWay, StringFormat={}{0:F1}°, TargetNullValue=-}"/>
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="該当する受信イベントはありません">
                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource PluginEmptyStateTextStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=AisTimelineGrid}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                             </Grid>
                             </Border>
                            <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"/>
                            <controls:TimelineDetailPane Grid.Row="3" DetailContent="{Binding SelectedTimelineMessage}"
                                EmptyText="時系列の受信イベントを選択すると、AIS メッセージの詳細が表示されます">
                                <controls:TimelineDetailPane.DetailContentTemplate><DataTemplate><StackPanel Margin="4,2">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Style="{DynamicResource PluginIdentityTextStyle}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ReceivedAt, StringFormat={}{0:yyyy/MM/dd HH:mm:ss.fff zzz}}" Style="{DynamicResource PluginTimelineDetailTimestampStyle}"/>
                                    </Grid>
                                    <UniformGrid Columns="4" Margin="0,4,0,2">
                                        <StackPanel><TextBlock Text="MMSI" Style="{DynamicResource PluginTimelineDetailLabelStyle}"/><TextBlock Text="{Binding Mmsi, StringFormat={}{0:000000000}}" Style="{DynamicResource PluginTimelineDetailValueStyle}"/></StackPanel>
                                        <StackPanel><TextBlock Text="種別 / チャンネル" Style="{DynamicResource PluginTimelineDetailLabelStyle}"/><TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}"><Run Text="{Binding MessageType, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Channel, Mode=OneWay}"/></TextBlock></StackPanel>
                                        <StackPanel><TextBlock Text="速度" Style="{DynamicResource PluginTimelineDetailLabelStyle}"/><TextBlock Text="{Binding SpeedKnots, StringFormat={}{0:F1} kt, TargetNullValue=—}" Style="{DynamicResource PluginTimelineDetailValueStyle}"/></StackPanel>
                                        <StackPanel><TextBlock Text="針路" Style="{DynamicResource PluginTimelineDetailLabelStyle}"/><TextBlock Text="{Binding CourseDegrees, StringFormat={}{0:F1}°, TargetNullValue=—}" Style="{DynamicResource PluginTimelineDetailValueStyle}"/></StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="{Binding Summary}" Style="{DynamicResource PluginTimelineDetailValueStyle}" Margin="0,4,0,0"/>
                                    <TextBlock Style="{DynamicResource PluginTimelineDetailValueStyle}" Margin="0,2,0,0"><Run Text="緯度 "/><Run Text="{Binding Latitude, StringFormat={}{0:F5}, TargetNullValue=—}"/><Run Text="  /  経度 "/><Run Text="{Binding Longitude, StringFormat={}{0:F5}, TargetNullValue=—}"/></TextBlock>
                                </StackPanel></DataTemplate></controls:TimelineDetailPane.DetailContentTemplate>
                            </controls:TimelineDetailPane>
                        </Grid>
                    </TabItem>

                    <TabItem Header="地図">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Margin="10,7" Foreground="{DynamicResource TextDimBrush}">
                                <Run Text="位置受信済み: "/><Run Text="{Binding PositionedTargetCount, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}"/><Run Text=" 局　|　位置出典: AIS無線メッセージ"/>
                            </TextBlock>
                            <Border Grid.Row="1" Margin="4" Background="{DynamicResource PanelBaseBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="2" ClipToBounds="True">
                                <Grid>
                                    <wpf:GeoMapView MapId="ais" LegendHtml="{x:Static ais:AisMapPresentation.LegendHtml}" LabelToggleText="船名" ItemsSource="{Binding MapMarkers}"/>
                                    <TextBlock Text="位置情報を含むAISメッセージをまだ受信していません">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PluginEmptyStateTextStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding PositionedTargetCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="診断">
                        <DockPanel Margin="12,10" LastChildFill="True">
                            <controls:DiagnosticsOverview DockPanel.Dock="Top"
                                StatusKind="{Binding OverallStatusKind}"
                                StatusText="{Binding OverallStatus}"
                                PhaseText="{Binding OverallPhase, StringFormat=段階: {0}}"
                                LastUpdatedText="{Binding OverallLastUpdated, StringFormat=更新 {0}}"
                                SummaryText="{Binding OverallSummary}"
                                RecommendationText="{Binding OverallRecommendation}"
                                RuntimeDiagnostics="{Binding RuntimeDiagnostics}"
                                ChannelText="{Binding MonitoredChannelsText, StringFormat=監視 {0}}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel MaxWidth="760">
                                <Expander Header="リアルタイム処理" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                    <controls:RuntimeDiagnosticsDetails RuntimeDiagnostics="{Binding RuntimeDiagnostics}" />
                                </Expander>
                                <Expander Header="入力・選局" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                <Border Style="{DynamicResource PluginMetricCardStyle}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="入力・選局" Style="{DynamicResource PluginSecondarySectionHeaderStyle}" Margin="0,0,0,9"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                                            <TextBlock Text="監視チャネル" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding MonitoredChannelsText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Text="チャネルオフセット" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ChannelOffsetText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Text="対象帯域" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PassbandStatusText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="3" Text="レート変換" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RateConversionSummaryText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="4" Text="IQ入力 → 中間 → 復調レート" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding IntermediateRateText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                </Expander>
                                <Expander Header="信号・チャネル" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                    <StackPanel Margin="8,5">
                                        <TextBlock Text="{Binding ChannelADiagnosticText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ChannelBDiagnosticText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="検出・同期・復調" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                <Border Style="{DynamicResource PluginMetricCardStyle}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="検出・同期・復調" Style="{DynamicResource PluginSecondarySectionHeaderStyle}" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                                            <TextBlock Text="AIS 1 到達数" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Grid.Column="1" Text="{Binding ChannelADetectionText}" FontFamily="{DynamicResource DisplayFontFamily}" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="1" Text="AIS 2 到達数" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ChannelBDetectionText}" FontFamily="{DynamicResource DisplayFontFamily}" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="2" Text="coherent / fallback（累積）" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Grid.Row="2" Grid.Column="1" FontFamily="{DynamicResource DisplayFontFamily}"><Run Text="{Binding CoherentFrames, Mode=OneWay, StringFormat=N0}"/><Run Text=" / "/><Run Text="{Binding FallbackFrames, Mode=OneWay, StringFormat=N0}"/></TextBlock>
                                            <TextBlock Grid.Row="3" Text="周波数補正（最新）" Foreground="{DynamicResource TextDimBrush}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FrequencyCorrectionText}" FontFamily="{DynamicResource DisplayFontFamily}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                </Expander>
                                <Expander Header="検証・復号" Style="{DynamicResource PluginDiagnosticsSectionStyle}">
                                    <StackPanel Margin="8,5">
                                        <TextBlock Text="{Binding RecentValidationText}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource DisplayFontFamily}" TextWrapping="Wrap"/>
                                        <TextBlock Foreground="{DynamicResource TextDimBrush}" FontFamily="{DynamicResource DisplayFontFamily}" Margin="0,4,0,0"><Run Text="累積（統計リセット以降）: 有効 "/><Run Text="{Binding ValidFrames, Mode=OneWay, StringFormat=N0}"/><Run Text=" / fallback FCS不一致 "/><Run Text="{Binding RejectedFrames, Mode=OneWay, StringFormat=N0}"/></TextBlock>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="詳細・デバッグ" Style="{DynamicResource PluginDiagnosticsSectionStyle}" IsExpanded="False">
                                    <StackPanel Margin="8,5">
                                        <TextBlock Text="GMSK 9600 bit/s / NRZI / HDLC / 複素整合相関 + coherent Viterbi MLSE" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding RateConversionText}" Foreground="{DynamicResource TextDimBrush}" FontFamily="{DynamicResource DisplayFontFamily}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
