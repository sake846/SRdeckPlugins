<UserControl x:Class="SRdeckPlugin.ActivityHeatmap.Views.ActivityHeatmapView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:SRdeckPlugin.ActivityHeatmap.Views"
 xmlns:plugin="clr-namespace:SRdeckPlugin.ActivityHeatmap"
 FontFamily="{DynamicResource MainFontFamily}" FontSize="10"
 Foreground="{DynamicResource TextPrimaryBrush}">
 <Grid Margin="8">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <Border Style="{DynamicResource PluginStatusHeaderStyle}">
   <DockPanel>
    <Button DockPanel.Dock="Right" Content="履歴クリア" Command="{Binding ClearCommand}"
     Style="{DynamicResource PluginButtonStyle}" ToolTip="活動ヒートマップの履歴を消去します"/>
    <TextBlock DockPanel.Dock="Left" Text="受信状態" Style="{DynamicResource PluginStatusHeaderTitleStyle}"/>
    <TextBlock Text="{Binding Status}" Margin="12,0,8,0" VerticalAlignment="Center"
     TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
   </DockPanel>
  </Border>
  <StackPanel Grid.Row="1" Margin="0,8" Orientation="Horizontal">
   <TextBlock Text="活動判定のしきい値" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <ComboBox ItemsSource="{x:Static plugin:ActivityViewModel.Thresholds}" SelectedItem="{Binding ThresholdDbm}"
    Style="{DynamicResource PluginComboBoxStyle}" Width="72" AutomationProperties.Name="活動判定のしきい値 dBm"/>
   <TextBlock Text="dBm / FFTビン" VerticalAlignment="Center" Margin="8,0,16,0"/>
   <TextBlock Text="表示期間" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <ComboBox ItemsSource="{x:Static plugin:ActivityViewModel.HistoryHoursOptions}" SelectedItem="{Binding HistoryHours}"
    Style="{DynamicResource PluginComboBoxStyle}" Width="64" AutomationProperties.Name="表示期間 時間"/>
   <TextBlock Text="時間" VerticalAlignment="Center" Margin="8,0,0,0"/>
   <TextBlock Text="範囲" VerticalAlignment="Center" Margin="16,0,8,0"/>
   <ComboBox ItemsSource="{x:Static plugin:ActivityViewModel.FrequencyRegions}" DisplayMemberPath="DisplayName"
    SelectedValuePath="Region" SelectedValue="{Binding FrequencyRegion}"
    Style="{DynamicResource PluginComboBoxStyle}" Width="148" AutomationProperties.Name="表示する周波数範囲"
    ToolTip="スペクトラムのズーム・パンに追従します。周波数範囲が変わると履歴をリセットします。"/>
  </StackPanel>
  <local:ActivityHeatmapPlot Grid.Row="2" Snapshot="{Binding Snapshot}" Focusable="True" RenderOptions.BitmapScalingMode="NearestNeighbor"
   AutomationProperties.Name="周波数ごとの活動ヒートマップ"
   AutomationProperties.HelpText="横軸は周波数、縦軸は時刻。矢印キーでセルの周波数、時刻、活動率を確認できます。"/>
  <StackPanel Grid.Row="3" Margin="0,8,0,0">
   <TextBlock Text="{Binding HistoryDescription}"
    FontSize="11" FontWeight="SemiBold"/>
   <TextBlock Text="色はしきい値を超えた観測の割合です。各セルの詳細はマウスまたは矢印キーで確認できます。"
    Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
   <TextBlock Text="スペクトラムと同じFFT値で判定します。欠落区間は未観測です。しきい値・周波数範囲の変更、受信再開で履歴をリセットします。"
    Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
  </StackPanel>
 </Grid>
</UserControl>
